---
import Layout from "../../../layouts/Layout.astro";
import { profile } from "../../../data/profile";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const faqs = [
  {
    q: "The app is not seeing my workouts",
    a: "Open the Health app, tap your picture, then Privacy, then Apps, then Hiking Passport, and turn on the categories you want to share. If a category is off, the plan simply works without it.",
  },
  {
    q: "My plan does not look right",
    a: "Tell the app what changed. An injury, a busy week, trail access, or a stretch of bad sleep all feed into the next plan. If it still looks wrong, email me with what you expected and what you got.",
  },
  {
    q: "Do I need Apple Intelligence?",
    a: "No. Apple Intelligence is what generates a plan for you. On a device that does not support it, or with it switched off, the app still runs and you set the plan yourself.",
  },
  {
    q: "How do I manage or cancel my subscription?",
    a: "Subscriptions are handled by Apple. Open Settings, tap your name, then Subscriptions, and choose Hiking Passport. You can change or cancel there at any time.",
  },
  {
    q: "I paid but the app still shows a paywall",
    a: "Use Restore Purchases in the app, on the same Apple Account you bought with. If it still does not unlock, email me and include the Apple Account email you used.",
  },
  {
    q: "Can I get a refund?",
    a: "Refunds go through Apple rather than me. Go to reportaproblem.apple.com, sign in, and choose the purchase.",
  },
  {
    q: "How do I delete my data?",
    a: "Deleting the app removes everything it stored on your iPhone. Your Apple Health data belongs to Apple Health and stays there. If you want the purchase record tied to your install deleted too, email me and I will take care of it.",
  },
  {
    q: "Something is hard to use, or unusable",
    a: "Tell me. Accessibility problems get treated as bugs, not requests. Describe what you hit and which assistive technology you were using and I will work on it.",
  },
];
---

<Layout
  title="Support, Hiking Passport"
  description="Help with Hiking Passport: Apple Health permissions, plans, subscriptions, and how to reach a human."
>
  <section class="post legal">
    <div class="wrap">
      <div class="post-head">
        <p class="eyebrow">Hiking Passport</p>
        <h1>Support</h1>
        <p class="lede">
          Hiking Passport is made by one person, and that person answers the
          email. Write to me and you get me, not a ticket queue.
        </p>
      </div>

      <div class="post-body">
        <h2>Get in touch</h2>
        <p>
          Email <a href={`mailto:${profile.email}`}>{profile.email}</a> with what
          happened and what you expected. If it is a bug, the iPhone model and
          the iOS version help me find it faster. I read every message and
          usually reply within a couple of days.
        </p>

        <h2>Common questions</h2>
        <div class="faq">
          {
            faqs.map((f) => (
              <details class="faq-item">
                <summary>
                  <span>{f.q}</span>
                  <span class="chev" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>

        <h2>Privacy</h2>
        <p>
          Hiking Passport has no account and no login, and your Apple Health
          data never leaves your iPhone. The{" "}
          <a href={`${base}/hiking-passport/privacy/`}>privacy policy</a>{" "}
          spells out exactly what the app reads and what leaves the device.
        </p>

        <h2>About the app</h2>
        <p>
          <a href={`${base}/hiking-passport/`}>Hiking Passport</a> builds a
          training plan for the hike you are working toward and shows your
          progress as a picture instead of a chart. It is made by Lilly Seay in
          Portland, Oregon.
        </p>
      </div>
    </div>
  </section>
</Layout>
