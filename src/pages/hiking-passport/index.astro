---
import Layout from "../../layouts/Layout.astro";
import { profile, hikingPassport as hp } from "../../data/profile";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${hp.name}, ${hp.tagline}`} description={hp.lede}>
  <section class="app-page">
    <div class="wrap">
      <header class="app-hero reveal">
        <p class="eyebrow">{hp.name}</p>
        <h1>Your season, <em>stamped</em>.</h1>
        <p class="lede">{hp.lede}</p>
        <p class="app-status">
          <span class="chip">{hp.status}</span>
        </p>
      </header>

      <ul class="app-shots reveal">
        {
          hp.shots.map((sh) => (
            <li>
              <img src={`${base}${sh.image}`} alt={sh.alt} loading="lazy" />
            </li>
          ))
        }
      </ul>
      <p class="shots-hint reveal">Scroll for more</p>

      <div class="app-steps stagger">
        {
          hp.steps.map((s, i) => (
            <div class="app-step">
              <span class="step-no">{i + 1}</span>
              <p class="step-kind">{s.kind}</p>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="app-block reveal">
        <h2>{hp.plan.title}</h2>
        {hp.plan.body.map((para) => <p>{para}</p>)}
      </div>

      <div class="app-block reveal">
        <h2>{hp.buddies.title}</h2>
        <p>{hp.buddies.body}</p>
        <ul class="buddy-list">
          {
            hp.buddies.list.map((b) => (
              <li>
                <strong>{b.name}</strong>
                <span class="buddy-who">{b.who}</span>
                <span class="buddy-note">{b.note}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <ul class="app-points stagger">
        {
          hp.points.map((p) => (
            <li class="card">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="app-block reveal">
        <h2>{hp.watch.title}</h2>
        <p>{hp.watch.body}</p>
      </div>

      <ul class="watch-shots stagger">
        {
          hp.watch.shots.map((w) => (
            <li>
              <div class="watch-frame">
                <img src={`${base}${w.image}`} alt={w.alt} loading="lazy" />
              </div>
              <p class="watch-cap">{w.cap}</p>
            </li>
          ))
        }
      </ul>

      <div class="app-block reveal">
        <h2>What it reads from Apple Health</h2>
        <p>
          With your permission the app reads five things: your steps, your
          walking and running distance, your flights climbed, your active
          energy, and your workouts. That is the whole list. It never writes
          anything back to Apple Health, and your Health data, your hikes, and
          your photos stay on your iPhone.
        </p>
        <p>
          The plan itself is built by rules, not by a model. Apple Intelligence
          runs on your iPhone and only ever writes words: looking up a trail's
          stats, naming your plan, and putting your buddy's daily note in their
          own voice. Turn it off and the plan is exactly the same.
        </p>
      </div>

      <div class="app-plans reveal">
        <h2>{hp.pricing.title}</h2>
        <div class="plan-cols">
          <div class="plan-col">
            <h3>Free</h3>
            <ul>{hp.pricing.free.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div class="plan-col pro">
            <h3>Pro</h3>
            <ul>{hp.pricing.pro.map((f) => <li>{f}</li>)}</ul>
          </div>
        </div>
        <p class="plan-note">{hp.requirements}</p>
      </div>

      <p class="app-made reveal">Made by one hiker, for hikers.</p>

      <div class="app-foot-links reveal">
        <a class="pill-link" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </div>
  </section>
</Layout>
