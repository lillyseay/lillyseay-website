---
import Layout from "../../layouts/Layout.astro";
import { profile, hikingPassport as hp } from "../../data/profile";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${hp.name}, ${hp.tagline}`}
  description={hp.lede}
>
  <section class="app-page">
    <div class="wrap">
      <header class="app-hero reveal">
        <p class="eyebrow">{hp.name}</p>
        <h1>See your training as a <em>picture</em>, not a chart.</h1>
        <p class="lede">{hp.lede}</p>
        <p class="app-status">
          <span class="chip">{hp.status}</span>
        </p>
      </header>

      <div class="app-art reveal" aria-hidden="true">
        <div class="pp-phone">
          <div class="pp-screen">
            <div class="pp-peak">
              <svg viewBox="0 0 220 150" role="presentation">
                <path class="pp-far" d="M0 150 L38 78 L70 110 L104 52 L150 108 L178 74 L220 150 Z"></path>
                <path class="pp-near" d="M0 150 L30 112 L62 132 L96 88 L134 128 L170 100 L220 150 Z"></path>
                <circle class="pp-sun" cx="168" cy="40" r="14"></circle>
              </svg>
              <div class="pp-fill"></div>
            </div>
            <div class="pp-rows">
              <span class="pp-row a"></span>
              <span class="pp-row b"></span>
              <span class="pp-row c"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="app-steps stagger">
        {
          hp.steps.map((s, i) => (
            <div class="app-step">
              <span class="step-no">{i + 1}</span>
              <p class="step-kind">{s.kind}</p>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="app-block reveal">
        <h2>What it reads, and what it never touches</h2>
        <p>
          With your permission Hiking Passport reads your workouts, steps,
          distance, flights climbed, and active energy, your heart rate and
          cardio fitness, and your sleep. It reads that data and nothing else,
          it never writes back to Apple Health, and your raw Health history
          never leaves your iPhone. Decline a category and the app still works,
          the plan is just less tailored.
        </p>
        <p>
          Plans are generated with Apple Intelligence. Short requests run on
          your iPhone, longer ones go to Apple's Private Cloud Compute, which
          returns your plan and keeps nothing. The full detail is in the{" "}
          <a href={`${base}/hiking-passport/privacy/`}>privacy policy</a>.
        </p>
      </div>

      <ul class="app-points stagger">
        {
          hp.points.map((p) => (
            <li class="card">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="app-foot-links reveal">
        <a class="pill-link" href={`${base}/hiking-passport/support/`}>Support</a>
        <a class="pill-link ghost" href={`${base}/hiking-passport/privacy/`}>Privacy policy</a>
        <a class="pill-link ghost" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </div>
  </section>
</Layout>
