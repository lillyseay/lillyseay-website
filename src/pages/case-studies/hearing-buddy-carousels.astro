---
import Layout from "../../layouts/Layout.astro";
import CarouselCase from "../../components/CarouselCase.astro";
import { profile, carouselCase } from "../../data/profile";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Carousel case study: TikTok photo carousels, Lilly Seay"
  description="190 TikTok photo carousels in six months on a character account, and the two formats that carried them."
>
  <section class="case-page">
    <div class="wrap">
      <p class="case-back reveal">
        <a href={`${base}/case-studies/`}>All case studies</a>
      </p>
      <div class="section-head left reveal">
        <p class="eyebrow">
          Channel case study · TikTok carousels · {carouselCase.period}
        </p>
        <h1>Same method, <em>no camera</em></h1>
        <p class="sub">
          Not every app can shoot video every day. The keyword test works just
          as well on TikTok photo carousels, and it runs from a character
          account rather than a founder's face. This is {carouselCase.account},
          Hearing Buddy's buddy Dash, posting nothing but carousels.
        </p>
      </div>
      <CarouselCase />
      <p class="routes-cta reveal">
        <a
          class="pill-link"
          href={`mailto:${profile.email}?subject=${encodeURIComponent("Carousels for my app")}`}
          >Get in touch</a
        >
        <a class="pill-link ghost" href={`${base}/case-studies/hearing-buddy-social/`}
          >The short-form video case study</a
        >
        <a class="pill-link ghost" href={`${base}/case-studies/`}>All case studies</a>
      </p>
    </div>
  </section>
</Layout>
