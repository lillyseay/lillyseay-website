---
import Layout from "../../layouts/Layout.astro";
import { caseStudies } from "../../data/caseStudies";
import { profile, socialCase, carouselCase } from "../../data/profile";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Channel case studies live as their own pages rather than in caseStudies.ts,
// because each one is driven by the numbers already in profile.ts.
const channels = [
  {
    href: `${base}/case-studies/hearing-buddy-social/`,
    kind: "Short-form video",
    name: "Find the series that converts",
    app: "Hearing Buddy · TikTok, Instagram, YouTube Shorts",
    body: "A keyword sheet of 100 topics turned into 210 videos in seven months. The series that people recognized did 3.4 times the views of one-offs.",
    stats: [
      { v: "210", l: "videos" },
      { v: "730K", l: "views" },
      { v: "64K", l: "best video" },
    ],
    period: socialCase.period,
  },
  {
    href: `${base}/case-studies/hearing-buddy-carousels/`,
    kind: "TikTok carousels",
    name: "Same method, no camera",
    app: `${carouselCase.account} · TikTok`,
    body: "The same keyword test run as photo carousels from a character account, for apps that can't shoot video every day. Numbered lists win by almost 7x.",
    stats: [
      { v: "190", l: "carousels" },
      { v: "151K", l: "views" },
      { v: "95%", l: "from For You" },
    ],
    period: carouselCase.period,
  },
];
---

<Layout
  title="Case studies, Lilly Seay"
  description="Design case studies for Hearing Buddy, Hiking Passport, and Tappily, plus channel case studies for short-form video and TikTok carousels."
>
  <section class="case-page">
    <div class="wrap">
      <div class="section-head left reveal">
        <p class="eyebrow">Case studies</p>
        <h1>The work, and <em>how it was made</em></h1>
        <p class="sub">
          I design and build the apps I ship, which means the research, the
          palette, the system and the App Store listing are all the same job.
          Product case studies below, then the channel case studies for the
          marketing that runs alongside them.
        </p>
      </div>

      <div class="case-method-note reveal">
        <h2>How I research</h2>
        <p>
          My user research runs on social media. I build a keyword sheet for the
          category, turn every topic into a short-form video, and let the view
          count tell me which pain point people relate to most. The comments are
          the qualitative half: hundreds of people describing, unprompted, the
          workarounds they built for a problem they had never named. It is
          faster than a recruiting pipeline, it is continuous, and the same
          videos that do the research do the marketing.
        </p>
      </div>

      <h2 class="case-group-head reveal">Product design</h2>
      <ul class="case-index stagger">
        {
          caseStudies.map((s) => (
            <li class="case-index-card">
              <a href={`${base}/case-studies/${s.slug}/`}>
                <div class="case-index-top">
                  {s.icon && (
                    <img
                      class="appcase-icon"
                      src={`${base}${s.icon}`}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                    />
                  )}
                  <div>
                    <p class="case-index-kind">
                      {s.years} · {s.status}
                    </p>
                    <h3>{s.name}</h3>
                    <p class="case-index-role">{s.role}</p>
                  </div>
                </div>
                <p class="case-index-body">{s.tagline}</p>
                <ul class="case-index-tags">
                  {s.badges.slice(0, 2).map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <span class="arrow-link">Read the case study</span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="case-group-head reveal">Social media channels</h2>
      <ul class="case-index channels stagger">
        {
          channels.map((c) => (
            <li class="case-index-card">
              <a href={c.href}>
                <div>
                  <p class="case-index-kind">
                    {c.kind} · {c.period}
                  </p>
                  <h3>{c.name}</h3>
                  <p class="case-index-role">{c.app}</p>
                </div>
                <p class="case-index-body">{c.body}</p>
                <dl class="case-index-stats">
                  {c.stats.map((s) => (
                    <div>
                      <dt>{s.l}</dt>
                      <dd>{s.v}</dd>
                    </div>
                  ))}
                </dl>
                <span class="arrow-link">Read the case study</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="routes-cta reveal">
        <a
          class="pill-link"
          href={`mailto:${profile.email}?subject=${encodeURIComponent("App design role")}`}
          >Get in touch</a
        >
        <a class="pill-link ghost" href={`${base}/#projects`}>See all work</a>
      </p>
    </div>
  </section>
</Layout>
