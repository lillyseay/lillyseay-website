---
import Layout from "../layouts/Layout.astro";
import Laurel from "../components/Laurel.astro";
import {
  profile,
  hearingBuddy,
  experience,
  projects,
  education,
  recognition,
  services,
} from "../data/profile";
---

<Layout title={`${profile.name}, iOS engineer and designer`}>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="pill fade-up">Made by someone with hearing loss</span>
        <h1 class="fade-up" style="--delay: 0.08s">
          Hi, I'm Lilly.<br />
          <span class="grad">I build apps that help people hear.</span>
        </h1>
        <p class="lede fade-up" style="--delay: 0.16s">{profile.headline}</p>
        <div class="actions fade-up" style="--delay: 0.24s">
          <a class="btn" href={profile.links.appStore}>Get Hearing Buddy</a>
          <a class="btn ghost" href={profile.links.linkedin}
            >Connect on LinkedIn</a
          >
        </div>
        <div class="fade-up" style="--delay: 0.32s">
          <Laurel
            title="Apple Design Award Finalist"
            subtitle="In inclusivity"
          />
        </div>
      </div>
      <div class="mock fade-up" style="--delay: 0.2s">
        <span class="chip tl">Live captions</span>
        <div
          class="card"
          aria-label="Example of shared captions in Hearing Buddy"
        >
          <h3>
            <span class="dot" aria-hidden="true"></span>Caption sharing · Room
            204
          </h3>
          <ul class="transcript">
            <li style="--delay: 0.6s">
              <span class="who">Teacher</span>
              Open your books to chapter four. We're starting with the water cycle
              today.
            </li>
            <li style="--delay: 1.2s">
              <span class="who">Student, back row</span>
              Can you go over evaporation again?
            </li>
            <li style="--delay: 1.8s">
              <span class="who">Teacher</span>
              Sure. Water heats up, turns into vapor, and rises. <span
                class="live">Then it cools and</span
              >
            </li>
          </ul>
        </div>
        <span class="chip br">On-device</span>
      </div>
    </div>
  </section>

  <section id="hearing-buddy">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">What I'm building</span>
        <h2>Meet <span class="grad">Hearing Buddy</span></h2>
        <p>{hearingBuddy.tagline} {hearingBuddy.description}</p>
      </div>
      <ul class="grid three reveal">
        {
          hearingBuddy.features.map((f) => (
            <li class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="section-head reveal" style="margin: 3rem auto 0">
        <ul class="plain muted" style="margin: 0 0 1.5rem">
          {hearingBuddy.recognition.map((r) => <li>{r}</li>)}
        </ul>
        <a class="btn" href={profile.links.appStore}
          >Download on the App Store</a
        >
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">Where I've worked</span>
        <h2>Ten years of <span class="grad">building things</span></h2>
        <p>
          From FPGA design to native apps to running an engineering training
          program, and now a company of my own.
        </p>
      </div>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="card reveal">
              <div class="when">
                {job.start} to {job.end}
              </div>
              <div>
                <h3>{job.role}</h3>
                <div class="org">{job.org}</div>
                <p>{job.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">Side projects</span>
        <h2>Apps I've <span class="grad">shipped</span></h2>
        <p>
          Built under Dalton Technologies, my independent studio, between client
          work.
        </p>
      </div>
      <ul class="grid two reveal">
        {
          projects.map((p) => (
            <li class="card">
              <h3>
                {p.name}{" "}
                <span class="muted" style="font-weight: 500">
                  {p.years}
                </span>
              </h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">About me</span>
        <h2>Engineer, designer, <span class="grad">founder</span></h2>
      </div>
      <div class="about-copy reveal">
        {profile.about.map((para) => <p>{para}</p>)}
      </div>
      <ul class="grid three reveal">
        <li class="card">
          <h3>Education</h3>
          <ul class="plain">
            <li>{education.degree}</li>
            <li>{education.school}, {education.years}</li>
            <li class="muted">{education.notes}</li>
          </ul>
        </li>
        <li class="card">
          <h3>Recognition</h3>
          <ul class="plain">
            {recognition.map((r) => <li>{r}</li>)}
          </ul>
        </li>
        <li class="card">
          <h3>What I work on</h3>
          <ul class="tags">
            {services.map((s) => <li>{s}</li>)}
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <div class="card reveal">
        <h2>Let's <span class="grad">connect</span></h2>
        <p>
          I'm happy to talk about accessibility, iOS, building apps, or speaking
          at your event.
        </p>
        <a class="btn" href={profile.links.linkedin}>Message me on LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>
