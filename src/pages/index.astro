---
import Layout from "../layouts/Layout.astro";
import {
  profile,
  featuredWork,
  inAppEvents,
  moreWork,
  recognition,
  servicesLine,
  talks,
  experience,
  social,
} from "../data/profile";
---

<Layout title={`${profile.name}, iOS engineer, designer, and founder`}>
  <section class="hero">
    <div class="wrap">
      <div class="meta fade-up">
        <span class="place">{profile.location}</span>
        <span class="tiny"
          ><a href={`mailto:${profile.email}`}>{profile.email}</a></span
        >
      </div>
      <h1 class="display name">{profile.name}</h1>
      <div class="fan" aria-hidden="true">
        <div class="fan-card box"></div>
        <div class="fan-card box"></div>
        <div class="fan-card box"></div>
        <div class="fan-card box"></div>
      </div>
      <h2 class="display tagline fade-up" style="--delay: 0.9s">
        iOS engineer,<br />designer &amp; <em>founder</em>
      </h2>
      <div class="lists fade-up" style="--delay: 1.1s">
        <div>
          <p class="eyebrow">Recognition includes</p>
          <p>{recognition.join(", ")}</p>
        </div>
        <div>
          <p class="eyebrow">Services</p>
          <p>{servicesLine.join(", ")}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="featured">
    <div class="wrap section-head reveal">
      <h2 class="display">Featured work</h2>
      <p>Apps I founded and campaigns I ran</p>
    </div>
    <div class="featured-track stagger" role="list">
      {
        featuredWork.map((w) => (
          <div class="feature-item" role="listitem">
            <div class={`box ${w.image ? "" : "empty"}`}>
              {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
            </div>
            <span class="label">{w.title}</span>
            <p class="kind">{w.kind}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="events">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">In-app events</h2>
        <p>App Store event cards I designed for my apps</p>
      </div>
      <ul class="events-grid stagger">
        {
          inAppEvents.map((e) => (
            <li>
              <div class={`box ${e.image ? "" : "empty"}`}>
                {e.image && (
                  <img
                    src={e.image}
                    alt={`${e.app}: ${e.title}`}
                    loading="lazy"
                  />
                )}
              </div>
              <div class="cap">
                <strong>{e.app}</strong>
                {e.title}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="more">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">More work</h2>
        <p>Take a scroll, stay a while</p>
      </div>
      <ul class="work-grid stagger">
        {
          moreWork.map((w) => (
            <li>
              <div class={`box ${w.image ? "" : "empty"}`}>
                {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">About</h2>
        <p>{profile.headline}</p>
      </div>
      <div class="about-copy reveal">
        {profile.about.map((para) => <p>{para}</p>)}
      </div>
      <div class="text-cols reveal">
        <div>
          <h3>Speaking</h3>
          <ul class="plain">
            {
              talks.map((t) => (
                <li>
                  <strong>{t.title}</strong>
                  <br />
                  <span class="muted">
                    {t.event}, {t.when}
                  </span>
                  {t.links.length > 0 && (
                    <>
                      <br />
                      {t.links.map((l, i) => (
                        <>
                          {i > 0 && " · "}
                          <a href={l.url}>{l.label}</a>
                        </>
                      ))}
                    </>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>Experience</h3>
          <ul class="plain">
            {
              experience.map((job) => (
                <li>
                  <strong>{job.role}</strong>
                  <br />
                  <span class="muted">
                    {job.org}, {job.start} to {job.end}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>Social</h3>
          <ul class="plain">
            {
              social.accounts.map((a) => (
                <li>
                  <strong>{a.name}</strong>{" "}
                  <span class="muted">{a.handle}</span>
                  <br />
                  {a.platforms.map((pl, i) => (
                    <>
                      {i > 0 && " · "}
                      <a href={pl.url}>{pl.name}</a>
                      {pl.stat && <span class="muted"> {pl.stat}</span>}
                    </>
                  ))}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap reveal">
      <h2 class="display" style="font-size: clamp(2.6rem, 6vw, 4.2rem)">
        Contact
      </h2>
      <div class="links">
        <a class="pill-link" href={`mailto:${profile.email}`}>{profile.email}</a
        >
        <a class="pill-link ghost" href={profile.links.linkedin}>LinkedIn</a>
        <a class="pill-link ghost" href="https://www.instagram.com/lillyseay/"
          >Instagram</a
        >
        <a class="pill-link ghost" href="https://www.tiktok.com/@lillyseay"
          >TikTok</a
        >
      </div>
    </div>
  </section>
</Layout>
