---
import Layout from "../layouts/Layout.astro";
import {
  profile,
  featuredWork,
  appStoreFeatures,
  moreWork,
  recognition,
  servicesLine,
  talks,
  community,
  experience,
  education,
  services,
  social,
} from "../data/profile";
---

<Layout title={`${profile.name}, iOS engineer, designer, and founder`}>
  <section class="hero">
    <div class="wrap">
      <div class="meta fade-up">
        <span class="place">{profile.location}</span>
        <span class="tiny"
          ><a href={`mailto:${profile.email}`}>{profile.email}</a></span
        >
      </div>
      <h1 class="display name">{profile.name}</h1>
      <div class="fan" aria-hidden="true">
        <div class="fan-card box"></div>
        <div class="fan-card box"></div>
        <div class="fan-card box"></div>
        <div class="fan-card box"></div>
      </div>
      <h2 class="display tagline fade-up" style="--delay: 0.9s">
        iOS engineer,<br />designer &amp; <em>founder</em>
      </h2>
      <div class="lists fade-up" style="--delay: 1.1s">
        <div>
          <p class="eyebrow">Recognition includes</p>
          <p>{recognition.join(", ")}</p>
        </div>
        <div>
          <p class="eyebrow">Services</p>
          <p>{servicesLine.join(", ")}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="featured">
    <div class="wrap section-head reveal">
      <h2 class="display">Featured work</h2>
      <p>Apps I founded and campaigns I ran</p>
    </div>
    <div class="featured-track stagger" role="list">
      {
        featuredWork.map((w) => (
          <div class="feature-item" role="listitem">
            <div class={`box ${w.image ? "" : "empty"}`}>
              {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
            </div>
            <span class="label">{w.title}</span>
            <p class="kind">{w.kind}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">App Store features</h2>
        <p>In-app events, feature graphics, and placements on the App Store</p>
      </div>
      <ul class="events-grid stagger">
        {
          appStoreFeatures.map((f) => {
            const art = f.image || f.screenshot;
            return (
              <li>
                <div class={`box ${art ? "" : "empty"}`}>
                  {art && (
                    <img
                      src={art}
                      alt={`${f.app}: ${f.title}`}
                      loading="lazy"
                    />
                  )}
                  <span class="kind-tag">{f.kind}</span>
                </div>
                <div class="cap">
                  <strong>{f.app}</strong>
                  {f.title}
                  {f.date && <span class="muted"> · {f.date}</span>}
                  {f.link && (
                    <>
                      <br />
                      <a class="cap-link" href={f.link}>
                        {f.link.includes("apps.apple.com")
                          ? "View on the App Store"
                          : "View feature"}
                      </a>
                    </>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section id="more">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">More work</h2>
        <p>Take a scroll, stay a while</p>
      </div>
      <ul class="work-grid stagger">
        {
          moreWork.map((w) => (
            <li>
              <div class={`box ${w.image ? "" : "empty"}`}>
                {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="social" class="band-soft">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">Social media</h2>
        <p>{social.intro}</p>
      </div>
      <ul class="grid two stagger">
        {
          social.services.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ul>
      <h3 class="subhead reveal">Accounts I run</h3>
      <ul class="grid three stagger">
        {
          social.accounts.map((a) => (
            <li class="card account">
              <h3>{a.name}</h3>
              <div class="org">{a.handle}</div>
              <p>{a.body}</p>
              <ul class="platforms">
                {a.platforms.map((pl) => (
                  <li>
                    <a href={pl.url}>{pl.name}</a>
                    {pl.stat && <span class="muted"> · {pl.stat}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="speaking">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">Speaking</h2>
        <p>
          Accessibility, Swift on hardware, and what it takes to ship an app as
          a small team
        </p>
      </div>
      <ul class="timeline stagger">
        {
          talks.map((t) => (
            <li class="card talk">
              <div class="when">{t.when}</div>
              <div>
                <h3>{t.title}</h3>
                <div class="org">
                  {t.event} · {t.where}
                </div>
                <p>{t.body}</p>
                {t.links.length > 0 && (
                  <p class="links">
                    {t.links.map((l) => (
                      <a href={l.url}>{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="card reveal" style="margin-top: 1.25rem">
        <h3>Apple and community</h3>
        <ul class="plain-list">
          {community.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">Experience</h2>
        <p>
          From FPGA design to native apps to running an engineering training
          program, and now a company of my own
        </p>
      </div>
      <ol class="timeline stagger">
        {
          experience.map((job) => (
            <li class="card">
              <div class="when">
                {job.start} to {job.end}
              </div>
              <div>
                <h3>{job.role}</h3>
                <div class="org">{job.org}</div>
                <p>{job.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="display">About</h2>
        <p>{profile.headline}</p>
      </div>
      <div class="about-copy reveal">
        {profile.about.map((para) => <p>{para}</p>)}
      </div>
      <ul class="grid two stagger">
        <li class="card">
          <h3>Education</h3>
          <ul class="plain-list">
            <li>{education.degree}</li>
            <li>{education.school}, {education.years}</li>
            <li class="muted">{education.notes}</li>
          </ul>
        </li>
        <li class="card">
          <h3>What I work on</h3>
          <ul class="tags">
            {services.map((s) => <li>{s}</li>)}
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap reveal">
      <h2 class="display" style="font-size: clamp(2.3rem, 5.2vw, 3.6rem)">
        Contact
      </h2>
      <div class="links">
        <a class="pill-link" href={`mailto:${profile.email}`}>{profile.email}</a
        >
        <a class="pill-link ghost" href={profile.links.linkedin}>LinkedIn</a>
        <a class="pill-link ghost" href="https://www.instagram.com/lillyseay/"
          >Instagram</a
        >
        <a class="pill-link ghost" href="https://www.tiktok.com/@lillyseay"
          >TikTok</a
        >
      </div>
    </div>
  </section>
</Layout>
