---
import Layout from "../layouts/Layout.astro";
import Ridgeline from "../components/Ridgeline.astro";
import TrailMap from "../components/TrailMap.astro";
import {
  profile,
  trail,
  journey,
  featuredWork,
  appStoreFeatures,
  moreWork,
  talks,
  community,
  education,
  social,
} from "../data/profile";
---

<Layout
  title={`${profile.name}, a career adventure through engineering, apps, and marketing`}
>
  <section class="hero" id="top">
    <div class="wrap">
      <h1>
        Hello, I'm Lilly. My career has been an <em>adventure</em> through
        <mark>electrical engineering</mark>, <mark>mobile app design</mark>, and
        <mark>marketing</mark>, with a few summits along the way.
      </h1>
      <p class="lede fade-up" style="--delay: 0.9s">
        Based in Portland, Oregon. On my journey I co-founded Hearing Buddy, a
        2026 Apple Design Award finalist, spoke at FOSDEM and at Apple, and grew
        a social audience past 115,000 followers.
      </p>
      <div class="hero-actions fade-up" style="--delay: 1.05s">
        <a class="pill-link" href="#trail">Follow the trail</a>
        <a class="pill-link ghost" href="#work">See what I built</a>
      </div>
    </div>
    <Ridgeline />
  </section>

  <section id="trail" class="trail-section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">The trail so far</p>
        <h2>Three basecamps, <em>one long climb</em></h2>
        <p class="sub">{trail.intro}</p>
      </div>
      <TrailMap />
    </div>
  </section>

  <section id="journey">
    <div class="wrap">
      <div class="section-head left reveal">
        <p class="eyebrow">Recent adventures</p>
        <h2>Where I've been, <em>and when</em></h2>
      </div>
      <ol class="journey stagger">
        {
          journey.map((j) => (
            <li>
              <span class="what">{j.what}</span>
              <span class="where">{j.where}</span>
              <span class="when">{j.when}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="work" class="featured">
    <div class="wrap section-head reveal">
      <p class="eyebrow">Things I built along the way</p>
      <h2>Apps, channels, <em>and campaigns</em></h2>
    </div>
    <div class="featured-track stagger" role="list">
      {
        featuredWork.map((w) => (
          <div class="feature-item" role="listitem">
            <div class={`box ${w.image ? "" : "empty"}`}>
              {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
            </div>
            <span class="label">{w.title}</span>
            <p class="kind">{w.kind}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Summit markers</p>
        <h2>Featured on the <em>App Store</em></h2>
        <p class="sub">In-app events, feature graphics, and placements</p>
      </div>
      <ul class="events-grid stagger">
        {
          appStoreFeatures.map((f) => {
            const art = f.image || f.screenshot;
            return (
              <li>
                <div class={`box ${art ? "" : "empty"}`}>
                  {art && (
                    <img
                      src={art}
                      alt={`${f.app}: ${f.title}`}
                      loading="lazy"
                    />
                  )}
                  <span class="kind-tag">{f.kind}</span>
                </div>
                <div class="cap">
                  <strong>{f.app}</strong>
                  {f.title}
                  {f.date && <span class="muted"> · {f.date}</span>}
                  {f.link && (
                    <>
                      <br />
                      <a class="cap-link" href={f.link}>
                        {f.link.includes("apps.apple.com")
                          ? "View on the App Store"
                          : "View feature"}
                      </a>
                    </>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section id="more">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">More from the trail</p>
        <h2>Take a scroll, <em>stay a while</em></h2>
      </div>
      <ul class="work-grid stagger">
        {
          moreWork.map((w) => (
            <li>
              <div class={`box ${w.image ? "" : "empty"}`}>
                {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="social" class="band-soft">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Sharing the trail</p>
        <h2>Marketing apps <em>on social</em></h2>
        <p class="sub">{social.intro}</p>
      </div>
      <ul class="grid two stagger">
        {
          social.services.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ul>
      <h3 class="subhead reveal">Accounts I run</h3>
      <ul class="grid three stagger">
        {
          social.accounts.map((a) => (
            <li class="card account">
              <h3>{a.name}</h3>
              <div class="org">{a.handle}</div>
              <p>{a.body}</p>
              <ul class="platforms">
                {a.platforms.map((pl) => (
                  <li>
                    <a href={pl.url}>{pl.name}</a>
                    {pl.stat && <span class="muted"> · {pl.stat}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="speaking">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Campfire talks</p>
        <h2>Stories I've told <em>on stage</em></h2>
        <p class="sub">
          Accessibility, Swift on hardware, and what it takes to ship an app as
          a small team
        </p>
      </div>
      <ul class="timeline stagger">
        {
          talks.map((t) => (
            <li class="card talk">
              <div class="when">{t.when}</div>
              <div>
                <h3>{t.title}</h3>
                <div class="org">
                  {t.event} · {t.where}
                </div>
                <p>{t.body}</p>
                {t.links.length > 0 && (
                  <p class="links">
                    {t.links.map((l) => (
                      <a href={l.url}>{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="card reveal" style="margin-top: 1.25rem">
        <h3>Apple and community</h3>
        <ul class="plain-list">
          {community.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap about-grid reveal">
      <div>
        <p class="eyebrow">Trail notes</p>
        <h2>Born in Oklahoma, <em>at home in the PNW</em></h2>
      </div>
      <div class="notes">
        {profile.about.map((para) => <p>{para}</p>)}
        <p>
          {education.degree}, {education.school}, {education.years}. {
            education.notes
          }
        </p>
        <p>
          When I'm not building, I'm on a paddleboard or a trail with two black
          labs, Jet and Nova.
        </p>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="wrap reveal">
      <div class="dash"></div>
      <h2 class="big">
        Build things that help people <em>hear, feel, and connect.</em>
      </h2>
      <div class="links">
        <a class="pill-link" href={`mailto:${profile.email}`}>Get in touch</a>
        <a class="pill-link ghost" href={profile.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>
