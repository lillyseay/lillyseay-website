---
import Layout from "../layouts/Layout.astro";
import Ridgeline from "../components/Ridgeline.astro";
import { posts } from "../data/blog";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Statements from "../components/Statements.astro";
import Accounts from "../components/Accounts.astro";
import {
  profile,
  journey,
  apps,
  moreApps,
  appStoreFeatures,
  campaigns,
  talks,
  community,
  education,
  social,
} from "../data/profile";
---

<Layout
  title={`${profile.name}, a career adventure through engineering, apps, and marketing`}
>
  <section class="hero" id="top">
    <div class="wrap">
      <span class="chip fade-up">Portland, OR</span>
      <h1>
        Hello, I'm Lilly. My career has been an <em>adventure</em> through
        <mark>mobile apps</mark>, <mark>electrical engineering</mark>, and
        <mark>marketing</mark>, with a few summits along the way.
      </h1>
      <div class="hero-actions fade-up" style="--delay: 0.9s">
        <a class="pill-link" href="#routes">Work with me</a>
        <a class="pill-link ghost" href="#projects">See my work</a>
      </div>
    </div>
    <Ridgeline />
  </section>

  <section id="routes" class="services">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Services</p>
        <h2>Here's what I <em>do</em></h2>
      </div>
      <Statements />
      <p class="routes-cta reveal">
        <a
          class="pill-link"
          href={`mailto:${profile.email}?subject=${encodeURIComponent("Start a project")}`}
          >Start a project</a
        >
      </p>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Projects</p>
        <h2>Apps I've <em>shipped</em></h2>
      </div>
      <ul class="apps-grid stagger">
        {
          apps.map((app) => (
            <li class="card app-card tilt">
              <div class="app-top">
                {app.icon ? (
                  <img
                    class="app-icon"
                    src={`${base}${app.icon}`}
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy"
                  />
                ) : (
                  <div class="app-icon placeholder" aria-hidden="true">
                    {app.name.charAt(0)}
                  </div>
                )}
                <div class="app-meta">
                  <h3>
                    {app.url ? <a href={app.url}>{app.name}</a> : app.name}
                  </h3>
                  <div class="org">
                    {app.year} · {app.platforms}
                  </div>
                </div>
              </div>
              <p class="tagline">{app.tagline}</p>
              <p>{app.body}</p>
              <div class="app-foot">
                {app.badges.length > 0 && (
                  <ul class="tags">
                    {app.badges.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                {app.url && (
                  <a class="arrow-link" href={app.url}>
                    Visit site
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <ul class="apps-more stagger">
        {
          moreApps.map((p) => (
            <li>
              <div class="app-icon placeholder small" aria-hidden="true">
                {p.name.charAt(0)}
              </div>
              <div>
                <h3>
                  {p.name} <span class="muted">{p.years}</span>
                </h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">App Store</p>
        <h2>Where I've been <em>featured</em></h2>
        <p class="sub">Feature graphics, placements, and in-app events</p>
      </div>
      <ul class="events-grid stagger">
        {
          appStoreFeatures.map((f) => {
            const art = f.image || f.screenshot;
            return (
              <li>
                <div class={`box ${art ? "" : "empty"}`}>
                  {art && (
                    <img
                      src={`${base}${art}`}
                      alt={`${f.app}: ${f.title}`}
                      loading="lazy"
                    />
                  )}
                  <span class="kind-tag">{f.kind}</span>
                </div>
                <div class="cap">
                  <strong>{f.app}</strong>
                  {f.title}
                  {f.date && <span class="muted"> · {f.date}</span>}
                  {f.link && (
                    <>
                      <br />
                      <a class="cap-link" href={f.link}>
                        {f.link.includes("apps.apple.com")
                          ? "View on the App Store"
                          : "View feature"}
                      </a>
                    </>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section id="campaigns">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">App Store campaigns</p>
        <h2>Campaigns I've <em>pitched to Apple</em></h2>
        <p class="sub">
          Every campaign is a pitch to Apple's editorial team plus the in-app
          events, artwork, and copy that ship with it. These are the ones I ran
          for Hearing Buddy this year.
        </p>
      </div>
      <div class="campaign-list stagger">
        {
          campaigns.map((c) => (
            <details class="campaign" id={`campaign-${c.slug}`}>
              <summary>
                <div class="campaign-preview" aria-hidden="true">
                  {c.events.length > 0 ? (
                    <>
                      <img
                        src={`${base}${c.events[0].image}`}
                        alt=""
                        loading="lazy"
                      />
                      {c.events.length > 1 && (
                        <span class="more">+{c.events.length - 1}</span>
                      )}
                    </>
                  ) : (
                    <span class="thumb-empty">Pitch only</span>
                  )}
                </div>
                <div class="campaign-title">
                  <p class="campaign-month">{c.month}</p>
                  <h3>{c.name}</h3>
                  <p class="campaign-summary">{c.summary}</p>
                  <ul class="tags">
                    <li>{c.type}</li>
                    {c.events.length > 0 && (
                      <li>
                        {c.events.length} in-app event
                        {c.events.length > 1 ? "s" : ""}
                      </li>
                    )}
                    {c.result && <li class="win">{c.result}</li>}
                  </ul>
                </div>
                <span class="chev" aria-hidden="true" />
              </summary>
              <div class={`campaign-body ${c.events.length > 2 ? "stacked" : ""}`}>
                <div class="pitch">
                  <p class="pitch-label">The campaign pitch</p>
                  {c.pitch.map((para) => (
                    <p>{para}</p>
                  ))}
                </div>
                {c.events.length > 0 && (
                  <div class={`campaign-events ${c.events.length > 2 ? "many" : ""}`}>
                    {c.events.map((ev) => (
                      <div class="event-card">
                        <div class="store-card">
                          <img
                            src={`${base}${ev.image}`}
                            alt=""
                            loading="lazy"
                          />
                          <div class="store-overlay">
                            <span class="store-badge">{ev.badge}</span>
                            <h4>{ev.name}</h4>
                            <p>{ev.short}</p>
                          </div>
                        </div>
                        <div class="event-copy">
                          <p class="event-long">{ev.long}</p>
                          <p class="event-when muted">
                            {"note" in ev && ev.note ? ev.note : `Ran ${ev.when}`}
                          </p>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="social">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Social media</p>
        <h2>Accounts I've <em>grown</em></h2>
        <p class="sub">{social.intro}</p>
      </div>
      <Accounts />
    </div>
  </section>

  <section id="journey">
    <div class="wrap">
      <div class="section-head left reveal">
        <p class="eyebrow">Recent adventures</p>
        <h2>Where I've been, <em>and when</em></h2>
      </div>
      <div class="journey stagger">
        {
          journey.map((j) => (
            <details class="journey-item">
              <summary>
                <span class="what">{j.what}</span>
                <span class="where">
                  {j.where}
                  <small>{j.type}</small>
                </span>
                <span class="when">{j.when}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <div class="journey-body">
                <p>{j.details}</p>
                {"bullets" in j && j.bullets && (
                  <ul class="journey-bullets">
                    {j.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="speaking">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Speaking</p>
        <h2>Talks I've given <em>on stage</em></h2>
        <p class="sub">
          Accessibility, Swift on hardware, and what it takes to ship an app as
          a small team
        </p>
      </div>
      <ul class="talks stagger">
        {
          talks.map((t) => (
            <li class="talk-feature">
              <div class="talk-photo tilt">
                <img src={`${base}${t.image}`} alt="" loading="lazy" />
              </div>
              <div class="talk-copy">
                <span class="chip">{t.when}</span>
                <h3>{t.title}</h3>
                <div class="org">
                  {t.event} · {t.where}
                </div>
                <p>{t.body}</p>
                <div class="talk-links">
                  {t.post && (
                    <a class="pill-link small" href={`${base}/blog/${t.post}/`}>
                      Read the story
                    </a>
                  )}
                  {t.links.map((l) => (
                    <a class="pill-link ghost small" href={l.url}>
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="card reveal community">
        <h3>Apple and community</h3>
        <ul class="plain-list">
          {community.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap about-grid reveal">
      <div>
        <p class="eyebrow">About</p>
        <h2>Where I'm from, <em>and where I am</em></h2>
      </div>
      <div class="notes">
        {profile.about.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <section id="writing">
    <div class="wrap">
      <div class="section-head left reveal">
        <p class="eyebrow">Writing</p>
        <h2>From <em>the blog</em></h2>
      </div>
      <ul class="post-list stagger">
        {
          posts.map((p) => (
            <li class="card post-card">
              <a href={`${base}/blog/${p.slug}/`}>
                <img src={`${base}${p.cover}`} alt="" loading="lazy" />
                <div class="post-card-body">
                  <div class="org">
                    {p.date} · {p.readTime}
                  </div>
                  <h3>{p.title}</h3>
                  <p>{p.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="closing">
    <div class="wrap reveal">
      <div class="dash"></div>
      <h2 class="big">
        Build things that help people <em>hear, feel, and connect.</em>
      </h2>
      <div class="links">
        <a class="pill-link" href={`mailto:${profile.email}`}>Get in touch</a>
        <a class="pill-link ghost" href={profile.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>
