---
import Layout from "../layouts/Layout.astro";
import Laurel from "../components/Laurel.astro";
import {
  profile,
  highlights,
  apps,
  moreApps,
  social,
  talks,
  community,
  experience,
  education,
  services,
} from "../data/profile";
---

<Layout title={`${profile.name}, iOS engineer, designer, and founder`}>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="pill fade-up">{profile.location}</span>
        <h1 class="fade-up" style="--delay: 0.08s">
          Hi, I'm Lilly.<br />
          <span class="grad">I design and build native apps.</span>
        </h1>
        <p class="lede fade-up" style="--delay: 0.16s">{profile.headline}</p>
        <div class="actions fade-up" style="--delay: 0.24s">
          <a class="btn" href="#apps">See my apps</a>
          <a class="btn ghost" href={`mailto:${profile.email}`}>Get in touch</a>
        </div>
        <div class="fade-up" style="--delay: 0.32s">
          <Laurel
            title="Apple Design Award Finalist"
            subtitle="2026 · Inclusivity"
          />
        </div>
      </div>
      <div class="mock fade-up" style="--delay: 0.2s">
        <span class="chip tl">Speaker</span>
        <div class="card" aria-label="Recent highlights">
          <h3><span class="dot" aria-hidden="true"></span>Recent highlights</h3>
          <ul class="transcript">
            {
              highlights.map((h, i) => (
                <li style={`--delay: ${0.5 + i * 0.35}s`}>
                  <span class="who">{h.year}</span>
                  {h.text}
                </li>
              ))
            }
          </ul>
        </div>
        <span class="chip br">Founder</span>
      </div>
    </div>
  </section>

  <section id="apps">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">What I've built</span>
        <h2>Apps people <span class="grad">actually use</span></h2>
        <p>
          Three products I founded and still run, plus a few smaller experiments
          along the way.
        </p>
      </div>
      <ul class="grid one reveal">
        {
          apps.map((app) => (
            <li class="card app">
              <div class="app-head">
                <div>
                  <h3>
                    <a href={app.url}>{app.name}</a>
                  </h3>
                  <div class="org">
                    {app.role} · {app.year}
                  </div>
                </div>
                <a class="btn ghost small" href={app.url}>
                  Visit site
                </a>
              </div>
              <p class="tagline">{app.tagline}</p>
              <p>{app.body}</p>
              {app.badges.length > 0 && (
                <ul class="tags">
                  {app.badges.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <ul class="grid two reveal" style="margin-top: 1.25rem">
        {
          moreApps.map((p) => (
            <li class="card">
              <h3>
                {p.name}{" "}
                <span class="muted" style="font-weight: 500">
                  {p.years}
                </span>
              </h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="social">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">Social media</span>
        <h2>Marketing apps <span class="grad">on social</span></h2>
        <p>{social.intro}</p>
      </div>
      <ul class="grid two reveal">
        {
          social.services.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ul>
      <h3 class="subhead reveal">Accounts I run</h3>
      <ul class="grid three reveal">
        {
          social.accounts.map((a) => (
            <li class="card account">
              <h3>{a.name}</h3>
              <div class="org">{a.handle}</div>
              <p>{a.body}</p>
              <ul class="platforms">
                {a.platforms.map((pl) => (
                  <li>
                    <a href={pl.url}>{pl.name}</a>
                    {pl.stat && <span class="muted"> · {pl.stat}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="speaking">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">Speaking</span>
        <h2>On stage, <span class="grad">on the record</span></h2>
        <p>
          I talk about accessibility, Swift on hardware, and what it takes to
          ship an app as a small team.
        </p>
      </div>
      <ul class="grid one reveal">
        {
          talks.map((t) => (
            <li class="card talk">
              <div class="when">{t.when}</div>
              <div>
                <h3>{t.title}</h3>
                <div class="org">
                  {t.event} · {t.where}
                </div>
                <p>{t.body}</p>
                {t.links.length > 0 && (
                  <p class="links">
                    {t.links.map((l) => (
                      <a href={l.url}>{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="card reveal" style="margin-top: 1.25rem">
        <h3>Apple and community</h3>
        <ul class="plain">
          {community.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">Where I've worked</span>
        <h2>Ten years of <span class="grad">building things</span></h2>
        <p>
          From FPGA design to native apps to running an engineering training
          program, and now a company of my own.
        </p>
      </div>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="card reveal">
              <div class="when">
                {job.start} to {job.end}
              </div>
              <div>
                <h3>{job.role}</h3>
                <div class="org">{job.org}</div>
                <p>{job.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="pill">About me</span>
        <h2>Engineer, designer, <span class="grad">founder</span></h2>
      </div>
      <div class="about-copy reveal">
        {profile.about.map((para) => <p>{para}</p>)}
      </div>
      <ul class="grid two reveal">
        <li class="card">
          <h3>Education</h3>
          <ul class="plain">
            <li>{education.degree}</li>
            <li>{education.school}, {education.years}</li>
            <li class="muted">{education.notes}</li>
          </ul>
        </li>
        <li class="card">
          <h3>What I work on</h3>
          <ul class="tags">
            {services.map((s) => <li>{s}</li>)}
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <section class="cta" id="contact">
    <div class="wrap">
      <div class="card reveal">
        <h2>Let's <span class="grad">connect</span></h2>
        <p>
          Happy to talk about accessibility, iOS, Swift on hardware, or speaking
          at your event.
        </p>
        <div class="actions" style="justify-content: center">
          <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="btn ghost" href={profile.links.linkedin}>LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
