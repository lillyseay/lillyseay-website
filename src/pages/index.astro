---
import Layout from "../layouts/Layout.astro";
import Ridgeline from "../components/Ridgeline.astro";
import Statements from "../components/Statements.astro";
import {
  profile,
  journey,
  featuredWork,
  apps,
  moreApps,
  appStoreFeatures,
  moreWork,
  talks,
  community,
  education,
  social,
} from "../data/profile";
---

<Layout
  title={`${profile.name}, a career adventure through engineering, apps, and marketing`}
>
  <section class="hero" id="top">
    <div class="wrap">
      <span class="chip fade-up">Portland, OR</span>
      <h1>
        Hello, I'm Lilly. My career has been an <em>adventure</em> through
        <mark>mobile apps</mark>, <mark>electrical engineering</mark>, and
        <mark>marketing</mark>, with a few summits along the way.
      </h1>
      <div class="hero-actions fade-up" style="--delay: 0.9s">
        <a class="pill-link" href="#routes">Work with me</a>
        <a class="pill-link ghost" href="#work">See my work</a>
      </div>
    </div>
    <Ridgeline />
  </section>

  <section id="routes" class="services">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Services</p>
        <h2>Here's what I <em>do</em></h2>
      </div>
      <Statements />
      <p class="routes-cta reveal">
        <a class="pill-link" href={`mailto:${profile.email}`}>Start a project</a
        >
      </p>
    </div>
  </section>

  <section id="journey">
    <div class="wrap">
      <div class="section-head left reveal">
        <p class="eyebrow">Recent adventures</p>
        <h2>Where I've been, <em>and when</em></h2>
      </div>
      <div class="journey stagger">
        {
          journey.map((j) => (
            <details class="journey-item">
              <summary>
                <span class="what">{j.what}</span>
                <span class="where">{j.where}</span>
                <span class="when">{j.when}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <div class="journey-body">
                <p>{j.details}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Projects</p>
        <h2>Apps I've <em>shipped</em></h2>
      </div>
      <ul class="grid one stagger">
        {
          apps.map((app) => (
            <li class="card app">
              <div class="app-head">
                <div>
                  <h3>
                    <a href={app.url}>{app.name}</a>
                  </h3>
                  <div class="org">
                    {app.role} · {app.year}
                  </div>
                </div>
                <a class="pill-link ghost small" href={app.url}>
                  Visit site
                </a>
              </div>
              <p class="tagline">{app.tagline}</p>
              <p>{app.body}</p>
              {app.badges.length > 0 && (
                <ul class="tags">
                  {app.badges.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <ul class="grid two stagger" style="margin-top: 1.25rem">
        {
          moreApps.map((p) => (
            <li class="card">
              <h3>
                {p.name}{" "}
                <span class="muted" style="font-weight: 500">
                  {p.years}
                </span>
              </h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="featured">
    <div class="wrap section-head reveal">
      <p class="eyebrow">Work</p>
      <h2>Apps, channels, <em>and campaigns</em></h2>
    </div>
    <div class="featured-track stagger" role="list">
      {
        featuredWork.map((w) => (
          <div class="feature-item" role="listitem">
            <div class={`box ${w.image ? "" : "empty"}`}>
              {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
            </div>
            <span class="label">{w.title}</span>
            <p class="kind">{w.kind}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">App Store</p>
        <h2>Featured on the <em>App Store</em></h2>
        <p class="sub">In-app events, feature graphics, and placements</p>
      </div>
      <ul class="events-grid stagger">
        {
          appStoreFeatures.map((f) => {
            const art = f.image || f.screenshot;
            return (
              <li>
                <div class={`box ${art ? "" : "empty"}`}>
                  {art && (
                    <img
                      src={art}
                      alt={`${f.app}: ${f.title}`}
                      loading="lazy"
                    />
                  )}
                  <span class="kind-tag">{f.kind}</span>
                </div>
                <div class="cap">
                  <strong>{f.app}</strong>
                  {f.title}
                  {f.date && <span class="muted"> · {f.date}</span>}
                  {f.link && (
                    <>
                      <br />
                      <a class="cap-link" href={f.link}>
                        {f.link.includes("apps.apple.com")
                          ? "View on the App Store"
                          : "View feature"}
                      </a>
                    </>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section id="more">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">More work</p>
        <h2>Take a scroll, <em>stay a while</em></h2>
      </div>
      <ul class="work-grid stagger">
        {
          moreWork.map((w) => (
            <li>
              <div class={`box ${w.image ? "" : "empty"}`}>
                {w.image && <img src={w.image} alt={w.title} loading="lazy" />}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="social" class="band-soft">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Social media marketing</p>
        <h2>Marketing apps <em>on social</em></h2>
        <p class="sub">{social.intro}</p>
      </div>
      <ul class="grid two stagger">
        {
          social.services.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ul>
      <h3 class="subhead reveal">Accounts I run</h3>
      <ul class="grid three stagger">
        {
          social.accounts.map((a) => (
            <li class="card account">
              <h3>{a.name}</h3>
              <div class="org">{a.handle}</div>
              <p>{a.body}</p>
              <ul class="platforms">
                {a.platforms.map((pl) => (
                  <li>
                    <a href={pl.url}>{pl.name}</a>
                    {pl.stat && <span class="muted"> · {pl.stat}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="speaking">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Speaking</p>
        <h2>Talks I've given <em>on stage</em></h2>
        <p class="sub">
          Accessibility, Swift on hardware, and what it takes to ship an app as
          a small team
        </p>
      </div>
      <ul class="timeline stagger">
        {
          talks.map((t) => (
            <li class="card talk">
              <div class="when">{t.when}</div>
              <div>
                <h3>{t.title}</h3>
                <div class="org">
                  {t.event} · {t.where}
                </div>
                <p>{t.body}</p>
                {t.links.length > 0 && (
                  <p class="links">
                    {t.links.map((l) => (
                      <a href={l.url}>{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="card reveal" style="margin-top: 1.25rem">
        <h3>Apple and community</h3>
        <ul class="plain-list">
          {community.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap about-grid reveal">
      <div>
        <p class="eyebrow">About</p>
        <h2>Born in Oklahoma, <em>at home in the PNW</em></h2>
      </div>
      <div class="notes">
        {profile.about.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="wrap reveal">
      <div class="dash"></div>
      <h2 class="big">
        Build things that help people <em>hear, feel, and connect.</em>
      </h2>
      <div class="links">
        <a class="pill-link" href={`mailto:${profile.email}`}>Get in touch</a>
        <a class="pill-link ghost" href={profile.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>
