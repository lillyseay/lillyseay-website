---
// Decorative rising bubbles in the page gutters, like hearingbuddyapp.com.
const tints = [
  "rgba(126, 184, 201, 0.22)",
  "rgba(125, 211, 168, 0.18)",
  "rgba(183, 215, 226, 0.28)",
  "rgba(232, 160, 176, 0.14)",
];
const make = (n: number, seed: number) =>
  Array.from({ length: n }, (_, i) => {
    const r = (k: number) => {
      const x = Math.sin(seed * 7919 + i * 104729 + k * 15485863) * 10000;
      return x - Math.floor(x);
    };
    return {
      size: 10 + Math.round(r(1) * 34),
      left: Math.round(r(2) * 90),
      dur: 18 + Math.round(r(3) * 18),
      delay: -Math.round(r(4) * 30),
      drift: Math.round(r(5) * 60 - 30),
      tint: tints[i % tints.length],
    };
  });
const left = make(7, 1);
const right = make(7, 2);
---

<div class="bubble-field" aria-hidden="true">
  <div class="bubble-gutter left">
    {
      left.map((b) => (
        <span
          class="bubble"
          style={`width:${b.size}px;height:${b.size}px;left:${b.left}%;--dur:${b.dur}s;--delay:${b.delay}s;--drift:${b.drift}px;--tint:${b.tint}`}
        />
      ))
    }
  </div>
  <div class="bubble-gutter right">
    {
      right.map((b) => (
        <span
          class="bubble"
          style={`width:${b.size}px;height:${b.size}px;left:${b.left}%;--dur:${b.dur}s;--delay:${b.delay}s;--drift:${b.drift}px;--tint:${b.tint}`}
        />
      ))
    }
  </div>
</div>
