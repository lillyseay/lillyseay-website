---
import { carouselCase as k } from "../data/profile";

const full = (n: number) => n.toLocaleString("en-US");

// Bar chart geometry (viewBox units), same shape as the video case study's charts.
// A single full-width chart, so the viewBox is sized close to its rendered
// width — the tick font is set in SVG user units and would scale up otherwise.
const W = 900;
const H = 300;
const padL = 10;
const padR = 10;
const padT = 30;
const padB = 46;
const viewsMax = Math.max(...k.views);
const barW = (W - padL - padR) / k.months.length;
const bars = k.views.map((v, i) => {
  const h = ((H - padT - padB) * v) / viewsMax;
  return {
    x: padL + i * barW + barW * 0.18,
    y: H - padB - h,
    w: barW * 0.64,
    h,
    v,
    m: k.months[i],
    posts: k.posts[i],
  };
});

const fmt = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K` : `${n}`;
const avgMax = Math.max(...k.formats.map((f) => f.avg));
---

<div class="case">
  <ul class="case-stats stagger">
    {
      k.stats.map((s) => (
        <li>
          <span
            class="case-num"
            data-count={s.value}
            data-decimals="0"
            data-suffix={"suffix" in s ? s.suffix : ""}
          >
            {full(s.value)}
            {"suffix" in s ? s.suffix : ""}
          </span>
          <span class="case-label">{s.label}</span>
          <span class="case-sub">{s.sub}</span>
        </li>
      ))
    }
  </ul>

  <div class="case-block reveal">
    <div class="case-block-head">
      <h4>Views and volume by month</h4>
      <p>
        {k.period}. The bars are views; the number under each month is how many
        carousels went out. July and August are the volume test — 123 posts
        across two months.
      </p>
    </div>
    <figure class="chart wide">
      <figcaption>
        <strong>{k.account}</strong>
        <span class="muted">{full(k.views.reduce((a, v) => a + v, 0))} views</span>
      </figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Monthly carousel views">
        <line class="axis" x1={padL} x2={W - padR} y1={H - padB} y2={H - padB} />
        {
          bars.map((r) => (
            <g class="bar">
              <rect x={r.x} y={r.y} width={r.w} height={Math.max(r.h, 1)} rx="3" />
              <rect
                class="hit"
                x={r.x - barW * 0.18}
                y={padT - 10}
                width={barW}
                height={H - padT - padB + 10}
              >
                <title>{`${r.m} 2026: ${full(r.v)} views from ${r.posts} carousels`}</title>
              </rect>
              <text
                class="tick"
                x={r.x + r.w / 2}
                y={H - padB + 18}
                text-anchor="middle"
              >
                {r.m}
              </text>
              <text
                class="tick posts"
                x={r.x + r.w / 2}
                y={H - padB + 36}
                text-anchor="middle"
              >
                {r.posts}
              </text>
            </g>
          ))
        }
      </svg>
    </figure>
  </div>

  <div class="case-block reveal">
    <div class="case-block-head">
      <h4>Which format earns the views</h4>
      <p>
        Every carousel sorted into a format, with the average views each one
        pulls. This is the whole argument for picking a format and repeating it.
      </p>
    </div>
    <ul class="format-list">
      {
        k.formats.map((f) => (
          <li class="format-row">
            <div class="format-main">
              <h5>{f.name}</h5>
              <p class="format-example">{f.example}</p>
            </div>
            <div class="format-bar">
              <span
                class="format-fill"
                style={`--pct:${Math.max((f.avg / avgMax) * 100, 2)}%`}
              />
              <span class="format-avg">{full(f.avg)} avg</span>
            </div>
            <dl class="format-stats">
              <div>
                <dt>Posts</dt>
                <dd>{f.n}</dd>
              </div>
              <div>
                <dt>Views</dt>
                <dd>{full(f.views)}</dd>
              </div>
              <div>
                <dt>Best</dt>
                <dd>{fmt(f.best)}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>
    <p class="format-takeaway">{k.takeaway}</p>
  </div>
</div>

<script>
  // Count up the stat tiles when they scroll into view.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nums = document.querySelectorAll<HTMLElement>(".case-num[data-count]");
  const render = (el: HTMLElement, v: number, dec: number) => {
    el.textContent =
      (dec ? v.toFixed(dec) : Math.round(v).toLocaleString("en-US")) +
      (el.dataset.suffix ?? "");
  };
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          const target = Number(el.dataset.count ?? "0");
          const dec = Number(el.dataset.decimals ?? "0");
          const t0 = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - t0) / 1500);
            render(el, target * (1 - Math.pow(1 - t, 3)), dec);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          io.unobserve(el);
        }
      },
      { threshold: 0.5 },
    );
    nums.forEach((el) => io.observe(el));
  }
</script>
