---
import { routes } from "../data/profile";
const icon = (d: string) =>
  d === "Full project" ? "▲▲▲" : d === "Campaign" ? "▲▲" : "▲";
---

<ul class="routes stagger">
  {
    routes.list.map((r) => (
      <li class="card route">
        <div class="route-head">
          <span
            class={`difficulty ${r.difficulty.toLowerCase().replace(/\s+/g, "-")}`}
          >
            <span class="peaks" aria-hidden="true">
              {icon(r.difficulty)}
            </span>
            {r.difficulty}
          </span>
          <span class="length">{r.length}</span>
        </div>
        <h3>{r.name}</h3>
        <p>{r.body}</p>
        <p class="eyebrow packed-label">Includes</p>
        <ul class="tags">
          {r.packed.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
