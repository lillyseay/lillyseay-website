---
import { trail } from "../data/profile";
---

<div class="trailmap">
  <svg
    class="trail-line"
    viewBox="0 0 40 1000"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      class="trail-path"
      d="M20 0 C34 120 6 220 20 340 C34 460 6 560 20 680 C34 800 6 900 20 1000"
    ></path>
  </svg>
  <ol class="basecamps">
    {
      trail.basecamps.map((camp, i) => (
        <li class="basecamp reveal">
          <div class="marker" aria-hidden="true">
            <span>{i + 1}</span>
          </div>
          <div class="camp-card card">
            <div class="camp-head">
              <div>
                <p class="eyebrow">
                  Basecamp {i + 1} · {camp.elevation}
                </p>
                <h3>{camp.name}</h3>
                <div class="org">
                  {camp.years} · {camp.place}
                </div>
              </div>
              {i === trail.basecamps.length - 1 && (
                <span class="flag" aria-label="You are here">
                  You are here
                </span>
              )}
            </div>
            <p>{camp.story}</p>
            <div class="camp-cols">
              <div>
                <p class="eyebrow">Stops along the way</p>
                <ul class="plain-list">
                  {camp.stops.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="eyebrow">Packed for the next leg</p>
                <ul class="tags">
                  {camp.skills.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>
