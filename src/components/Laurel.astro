---
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<div class="laurel">
  <svg
    viewBox="0 0 24 34"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M20 2c-6 2-10 8-10 16 0 6 3 11 8 14"></path>
    <path
      d="M18 8c-3 0-5 1-6 3M17 13c-3 0-5 1-6 4M17 19c-3 0-5 2-5 5M18 25c-3 0-4 2-4 4"
    ></path>
  </svg>
  <div class="t">
    <strong>{title}</strong>
    <span>{subtitle}</span>
  </div>
  <svg
    viewBox="0 0 24 34"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M20 2c-6 2-10 8-10 16 0 6 3 11 8 14"></path>
    <path
      d="M18 8c-3 0-5 1-6 3M17 13c-3 0-5 1-6 4M17 19c-3 0-5 2-5 5M18 25c-3 0-4 2-4 4"
    ></path>
  </svg>
</div>
