---
// Layered mountain range where the front ridge's summits are career accomplishments.
// Shapes are generated with a seeded random walk so they look rugged but build identically every time.
import { summits } from "../data/profile";

const W = 1440;
const H = 400;
const baseY = 340;
const peakY = (h: number) => baseY - (h / 100) * 250;

// Seeded PRNG (mulberry32)
const rng = (seed: number) => () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

type Pt = [number, number];

// A rugged ridge: broad peaks placed at `peaks` (x, y) with jittered slopes between them.
function ruggedRidge(
  seed: number,
  peaks: { x: number; y: number }[],
  valleyY: number,
  jitter: number,
  step = 18,
): string {
  const r = rng(seed);
  const anchors: Pt[] = [[-40, valleyY - 10 - r() * 20]];
  peaks.forEach((p, i) => {
    const prev = anchors[anchors.length - 1];
    // a valley between peaks, offset a little so slopes are asymmetric
    if (i > 0) {
      const vx = (prev[0] + p.x) / 2 + (r() - 0.5) * 60;
      anchors.push([vx, valleyY + (r() - 0.5) * 30]);
    }
    // sub-peak on the way up gives the "shoulder" look
    anchors.push([p.x - 90 - r() * 40, p.y + 70 + r() * 50]);
    anchors.push([p.x, p.y]);
    anchors.push([p.x + 60 + r() * 40, p.y + 55 + r() * 45]);
  });
  anchors.push([W + 40, valleyY - r() * 30]);

  // Interpolate between anchors with small jitter so slopes read as rock, not straight lines.
  const pts: Pt[] = [];
  for (let i = 0; i < anchors.length - 1; i++) {
    const [x0, y0] = anchors[i];
    const [x1, y1] = anchors[i + 1];
    const n = Math.max(2, Math.round((x1 - x0) / step));
    for (let k = 0; k < n; k++) {
      const t = k / n;
      const x = x0 + (x1 - x0) * t;
      const y = y0 + (y1 - y0) * t;
      // keep the exact apex sharp: no jitter at anchor points
      const j =
        k === 0
          ? 0
          : (r() - 0.5) * jitter * Math.min(1, Math.abs(y1 - y0) / 60 + 0.4);
      pts.push([x, y + j]);
    }
  }
  pts.push(anchors[anchors.length - 1]);
  return (
    "M" +
    pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(" L ") +
    ` L ${W + 40} ${H + 10} L -40 ${H + 10} Z`
  );
}

// Background ranges: random peaks, lower and softer the farther back.
function backgroundRidge(
  seed: number,
  count: number,
  minY: number,
  maxY: number,
  valleyY: number,
  jitter: number,
) {
  const r = rng(seed);
  const peaks = Array.from({ length: count }, (_, i) => ({
    x: ((i + 0.5 + (r() - 0.5) * 0.6) / count) * W,
    y: minY + r() * (maxY - minY),
  }));
  return ruggedRidge(seed * 7 + 1, peaks, valleyY, jitter, 22);
}

const frontPeaks = summits.map((s) => ({
  x: (s.x / 100) * W,
  y: peakY(s.height),
}));
const frontPath = ruggedRidge(11, frontPeaks, baseY - 20, 16, 16);
const layers = [
  backgroundRidge(2, 6, 60, 150, 250, 10),
  backgroundRidge(3, 5, 120, 200, 285, 12),
  backgroundRidge(5, 7, 190, 250, 310, 12),
];
const groundPath = `M-40 ${H + 10} L-40 ${baseY + 12} C 200 ${baseY} 480 ${baseY + 22} 760 ${baseY + 6} C 1000 ${baseY - 8} 1240 ${baseY + 18} ${W + 40} ${baseY + 4} L ${W + 40} ${H + 10} Z`;
---

<div class="ridge" aria-label="Career summits">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMax meet"
    aria-hidden="true"
  >
    <path class="layer layer-1" d={layers[0]}></path>
    <ellipse class="fog fog-a" cx="420" cy="250" rx="380" ry="26"></ellipse>
    <path class="layer layer-2" d={layers[1]}></path>
    <ellipse class="fog fog-b" cx="1080" cy="290" rx="420" ry="24"></ellipse>
    <path class="layer layer-3" d={layers[2]}></path>
    <path class="layer layer-front" d={frontPath}></path>
    <path class="ground" d={groundPath}></path>
    {
      summits.map((s, i) => {
        const px = (s.x / 100) * W;
        const py = peakY(s.height);
        return (
          <g
            class="summit-flag"
            style={`--i: ${i}`}
            transform={`translate(${px.toFixed(0)} ${py.toFixed(0)})`}
          >
            <line x1="0" y1="0" x2="0" y2="-42" />
            <path d="M0 -42 L26 -34 L0 -26 Z" />
            <circle cx="0" cy="0" r="5" />
          </g>
        );
      })
    }
  </svg>
  <ol class="summit-labels">
    {
      summits.map((s, i) => (
        <li
          class="summit-label"
          style={`--x: ${s.x}%; --y: ${((H - peakY(s.height)) / H) * 100}%; --i: ${i}`}
        >
          <span class="year">{s.year}</span>
          <span class="name">{s.label}</span>
        </li>
      ))
    }
  </ol>
  <ol class="summit-list">
    {
      summits.map((s) => (
        <li>
          <span class="year">{s.year}</span> {s.label}
        </li>
      ))
    }
  </ol>
</div>
