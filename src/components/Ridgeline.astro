---
// Pacific Northwest ridgeline where each summit is a career accomplishment.
// Peaks are generated from `summits` so their heights rise left to right.
import { summits } from "../data/profile";

const W = 1440;
const H = 460;
const baseY = 400; // valley floor
const peakY = (h: number) => baseY - (h / 100) * 300; // 0..100 -> 400..100

// Build the main ridge as a polyline: valley, peak, valley, peak...
const pts: [number, number][] = [[0, baseY - 20]];
summits.forEach((s, i) => {
  const px = (s.x / 100) * W;
  const py = peakY(s.height);
  const prevX = i === 0 ? 0 : (summits[i - 1].x / 100) * W;
  const valleyX = (prevX + px) / 2;
  const valleyY = baseY - 40 - Math.random() * 0; // flat-ish valleys
  if (i > 0) pts.push([valleyX, valleyY]);
  // shoulder before and after the peak for a more natural silhouette
  pts.push([px - 70, py + 90]);
  pts.push([px, py]);
  pts.push([px + 60, py + 80]);
});
pts.push([W, baseY - 30]);
const ridgePath =
  "M" +
  pts.map(([x, y]) => `${x.toFixed(0)} ${y.toFixed(0)}`).join(" L ") +
  ` L ${W} ${H} L 0 ${H} Z`;

// Far range: softer, lower, offset peaks
const farPath =
  `M0 330 L120 270 L230 300 L340 220 L450 280 L560 200 L680 270 L800 210 L920 280 ` +
  `L1040 190 L1160 260 L1280 210 L1380 270 L${W} 240 L${W} ${H} L0 ${H} Z`;

// Trail: dashed path from the left edge climbing peak to peak
const trailPts = summits.map(
  (s) => `${((s.x / 100) * W).toFixed(0)} ${(peakY(s.height) + 6).toFixed(0)}`,
);
const trailPath =
  `M-20 ${baseY - 10} C 120 ${baseY - 20} 160 ${peakY(summits[0].height) + 40} ${trailPts[0]} ` +
  summits
    .slice(1)
    .map((s, i) => {
      const prev = summits[i];
      const x1 = ((prev.x + s.x) / 2 / 100) * W;
      return `C ${x1.toFixed(0)} ${baseY - 30} ${x1.toFixed(0)} ${(peakY(s.height) + 60).toFixed(0)} ${trailPts[i + 1]}`;
    })
    .join(" ");
---

<div class="ridge" aria-label="Career summits">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMax meet"
    aria-hidden="true"
  >
    <path class="ridge-far" d={farPath}></path>
    <ellipse class="fog fog-a" cx="420" cy="330" rx="380" ry="30"></ellipse>
    <ellipse class="fog fog-b" cx="1080" cy="310" rx="420" ry="28"></ellipse>
    <path class="ridge-mid" d={ridgePath}></path>
    <g class="trees">
      <path
        d="M60 460 L60 402 M60 402 L44 430 L76 430 Z M60 414 L48 438 L72 438 Z"
      ></path>
      <path
        d="M1380 460 L1380 396 M1380 396 L1360 432 L1400 432 Z M1380 410 L1364 442 L1396 442 Z"
      ></path>
    </g>
    <path
      class="ground"
      d={`M0 ${H} L0 ${baseY + 10} C300 ${baseY - 6} 700 ${baseY + 14} 1100 ${baseY - 2} C1250 ${baseY - 8} 1360 ${baseY + 6} ${W} ${baseY + 2} L${W} ${H} Z`}
    ></path>
    <path class="trail" d={trailPath}></path>
    {
      summits.map((s, i) => {
        const px = (s.x / 100) * W;
        const py = peakY(s.height);
        return (
          <g
            class="summit-flag"
            style={`--i: ${i}`}
            transform={`translate(${px.toFixed(0)} ${py.toFixed(0)})`}
          >
            <line x1="0" y1="0" x2="0" y2="-42" />
            <path d="M0 -42 L26 -34 L0 -26 Z" />
            <circle cx="0" cy="0" r="5" />
          </g>
        );
      })
    }
  </svg>
  <ol class="summit-labels">
    {
      summits.map((s, i) => (
        <li
          class="summit-label"
          style={`--x: ${s.x}%; --y: ${((H - peakY(s.height)) / H) * 100}%; --i: ${i}`}
        >
          <span class="year">{s.year}</span>
          <span class="name">{s.label}</span>
        </li>
      ))
    }
  </ol>
  <ol class="summit-list">
    {
      summits.map((s) => (
        <li>
          <span class="year">{s.year}</span> {s.label}
        </li>
      ))
    }
  </ol>
</div>
