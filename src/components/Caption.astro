---
// A headline styled like a live caption. Types itself in on load;
// shows instantly when the visitor prefers reduced motion.
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<h1 class="caption" data-text={text} aria-label={text}>
  <span class="typed" aria-hidden="true">{text}</span><span
    class="cursor"
    aria-hidden="true"></span>
</h1>

<script>
  const el = document.querySelector<HTMLElement>(".caption");
  const typed = el?.querySelector<HTMLElement>(".typed");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && typed && !reduce) {
    const full = el.dataset.text ?? "";
    const words = full.split(" ");
    let i = 0;
    typed.textContent = "";
    const tick = () => {
      i += 1;
      typed.textContent = words.slice(0, i).join(" ");
      if (i < words.length) {
        // Captions arrive in small bursts, not one letter at a time.
        setTimeout(tick, 90 + Math.random() * 140);
      } else {
        el.classList.add("done");
      }
    };
    setTimeout(tick, 350);
  } else {
    el?.classList.add("done");
  }
</script>
