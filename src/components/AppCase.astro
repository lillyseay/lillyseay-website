---
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  study: CaseStudy;
}

const { study: s } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Headings carry a single "|". Everything after it renders in the app's accent.
const split = (t: string) => {
  const [lead, accent] = t.split("|");
  return { lead: lead.trim(), accent: accent?.trim() };
};

const theme = [
  `--from:${s.accent.from}`,
  `--mid:${s.accent.mid}`,
  `--to:${s.accent.to}`,
  `--band:${s.band.light}`,
  `--band-dk:${s.band.dark}`,
].join("; ");

const h = {
  problem: split(s.problem.heading),
  research: split(s.research.heading),
  strategy: split(s.strategy.heading),
  ux: split(s.ux.heading),
  identity: split(s.identity.heading),
  product: split(s.product.heading),
  marketing: split(s.marketing.heading),
  social: split(s.social.heading),
};
---

<article class="bh" id={s.slug} style={theme}>
  {/* ══ Hero and overview ═══════════════════════════════════════════════ */}
  <div class="bh-meta reveal">
    <span>{s.category}</span>
    <span>Design case study</span>
    <span>{s.years}</span>
  </div>

  <header class="bh-hero">
    <span class="bh-ghost" aria-hidden="true">{s.name}</span>
    <svg class="bh-arc" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="198"></circle>
      <circle cx="200" cy="200" r="150"></circle>
    </svg>
    <div class="bh-hero-inner">
      {
        s.icon && (
          <img
            class="bh-hero-icon float"
            src={`${base}${s.icon}`}
            alt=""
            width="112"
            height="112"
          />
        )
      }
      <h1 class="bh-title">{s.name}</h1>
      <p class="bh-lede">{s.lede}</p>
      <p class="bh-status">{s.status}</p>
    </div>
  </header>

  <section class="bh-overview">
    <ul class="bh-ov-stats stagger">
      {
        s.overview.stats.map((st, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-ov-v" data-count={st.value}>
              {st.value}
            </span>
            <span class="bh-ov-l">{st.label}</span>
          </li>
        ))
      }
    </ul>
    <dl class="bh-facts reveal">
      {
        s.overview.facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ══ 01 Problem ══════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">01</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Problem</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.problem.lead}{h.problem.accent && <em>{h.problem.accent}</em>}
      </h2>
      <p class="bh-body">{s.problem.note}</p>
    </div>
    {
      s.problem.scale && (
        <ul class="bh-scale stagger">
          {s.problem.scale.map((a, i) => (
            <li style={`--i:${i}`}>
              <span class="bh-scale-v" data-count={a.value}>
                {a.value}
              </span>
              <span class="bh-scale-l">{a.label}</span>
              {a.source && <span class="bh-scale-src">{a.source}</span>}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ══ 02 Research ═════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">02</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Research</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.research.lead}{h.research.accent && <em>{h.research.accent}</em>}
      </h2>
      <p class="bh-body">{s.research.note}</p>
    </div>

    {
      s.research.quotes && (
        <div class="bh-comments-wrap">
          <p class="bh-comments-head reveal">
            <span>{s.research.quotes.length} comments</span>
            <small>@hearingbuddy · TikTok</small>
          </p>
          <ul class="bh-comments stagger">
            {s.research.quotes.map((q, i) => (
              <li style={`--i:${i}`}>
                <span class="bh-av" aria-hidden="true">
                  {q.user.replace(/^@/, "").charAt(0).toUpperCase()}
                </span>
                <div class="bh-c-body">
                  <p class="bh-c-user">{q.user}</p>
                  <p class="bh-c-text">{q.text}</p>
                  <p class="bh-c-foot">
                    <span>{q.date}</span>
                    <span>Reply</span>
                    {q.replies ? (
                      <span>
                        View {q.replies} {q.replies === 1 ? "reply" : "replies"}
                      </span>
                    ) : null}
                  </p>
                </div>
                <span class="bh-c-like">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21s-7.5-4.6-9.6-9A5.2 5.2 0 0 1 12 6.6 5.2 5.2 0 0 1 21.6 12c-2.1 4.4-9.6 9-9.6 9z" />
                  </svg>
                  <em>{q.likes}</em>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      s.research.pullQuote && (
        <figure class="bh-pull reveal">
          <span class="bh-quote-mark" aria-hidden="true">
            //
          </span>
          <blockquote>{s.research.pullQuote.text}</blockquote>
          <figcaption>{s.research.pullQuote.cite}</figcaption>
        </figure>
      )
    }

    {
      s.research.findings && (
        <>
          <p class="bh-sub-label reveal">Pain points identified</p>
          <div class="bh-hub reveal">
            <div class="bh-hub-core">
              <span>{s.research.findings.length}</span>
              <small>pain points</small>
            </div>
            <ul class="bh-hub-list stagger">
              {s.research.findings.map((f, i) => (
                <li style={`--i:${i}`}>
                  <span class="bh-hub-dot" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h4>{f.signal}</h4>
                  <p>{f.shipped}</p>
                </li>
              ))}
            </ul>
          </div>
        </>
      )
    }

    {
      s.research.audiences && (
        <>
          <p class="bh-sub-label reveal">Who it turned out to be for</p>
          <ul class="bh-aud-list stagger">
            {s.research.audiences.map((a, i) => (
              <li style={`--i:${i}`}>
                <span class="bh-aud-dot" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h4>{a.name}</h4>
                <p>{a.detail}</p>
                <p class="bh-aud-ev">{a.evidence}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  {/* ══ 03 Product strategy ═════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">03</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Product strategy</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.strategy.lead}{h.strategy.accent && <em>{h.strategy.accent}</em>}
      </h2>
      <p class="bh-body">{s.strategy.note}</p>
    </div>
    <ol class="bh-bets stagger">
      {
        s.strategy.bets.map((b, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-bet-num">{String(i + 1).padStart(2, "0")}</span>
            <h4>{b.title}</h4>
            <p>{b.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ══ 04 UX ═══════════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">04</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">UX</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.ux.lead}{h.ux.accent && <em>{h.ux.accent}</em>}
      </h2>
      <p class="bh-body">{s.ux.note}</p>
    </div>

    {
      s.ux.anatomy && (
        <div class="bh-anatomy reveal">
          <div class="bh-anatomy-shot">
            {s.ux.anatomy.shot && (
              <img
                src={`${base}${s.ux.anatomy.shot.src}`}
                alt={s.ux.anatomy.shot.alt}
                loading="lazy"
              />
            )}
          </div>
          <div class="bh-anatomy-key">
            <p class="bh-sub-label flush">Anatomy</p>
            <h3 class="bh-anatomy-title">{s.ux.anatomy.title}</h3>
            <p class="bh-ct-note">{s.ux.anatomy.note}</p>
            <ol class="bh-parts">
              {s.ux.anatomy.parts.map((p, i) => (
                <li>
                  <span class="bh-part-num" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <p class="bh-part-name">{p.name}</p>
                    <p class="bh-part-detail">{p.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )
    }

    <p class="bh-sub-label reveal">Interaction rules</p>
    <ul class="bh-rules stagger">
      {
        s.ux.rules.map((r, i) => (
          <li style={`--i:${i}`}>
            <h4>{r.title}</h4>
            <p>{r.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ══ 05 Visual identity ══════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">05</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Visual identity</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.identity.lead}{h.identity.accent && <em>{h.identity.accent}</em>}
      </h2>
      <p class="bh-body">{s.identity.note}</p>
    </div>

    <div class="bh-ct">
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">Colour</p>
        <p class="bh-ct-note">{s.identity.palette.note}</p>
        {
          s.identity.palette.groups.map((g) => (
            <div class="bh-pal-row">
              <p class="bh-pal-name">{g.name}</p>
              <ul class="bh-chipset">
                {g.swatches.map((w) => (
                  <li style={`--c:${w.hex}`}>
                    <span class="bh-chip" aria-hidden="true" />
                    <span class="bh-chip-hex">{w.hex}</span>
                    <span class="bh-chip-name">{w.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">Typography</p>
        <p class="bh-ct-note">{s.identity.typography.note}</p>
        <ul class="bh-faces">
          {
            s.identity.typography.faces.map((f) => (
              <li>
                <span class="bh-face-sample" aria-hidden="true">
                  {f.sample}
                </span>
                <div>
                  <p class="bh-face-name">{f.name}</p>
                  <p class="bh-face-role">{f.role}</p>
                  <p class="bh-face-detail">{f.detail}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    s.identity.characters && (
      <section class="bh-band">
        <p class="bh-sub-label reveal flush">{s.identity.characters.title}</p>
        <p class="bh-body wide reveal">{s.identity.characters.note}</p>
        <ul class="bh-cast stagger">
          {s.identity.characters.list.map((c, i) => (
            <li style={`--i:${i}; --a:${c.hex}; --b:${c.to}`}>
              <span class="bh-cast-art">
                <img
                  src={`${base}/case-studies/${s.slug}/buddies/${c.file}`}
                  alt={`${c.name}, ${c.role}`}
                  loading="lazy"
                />
              </span>
              <span class="bh-cast-name">{c.name}</span>
              <span class="bh-cast-role">{c.role}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    s.identity.themes && (
      <section class="bh-sec">
        <p class="bh-sub-label reveal flush">{s.identity.themes.title}</p>
        <p class="bh-body wide reveal">{s.identity.themes.note}</p>
        <ul class="bh-themes stagger">
          {s.identity.themes.list.map((t, i) => (
            <li style={`--i:${i}`}>
              <img
                src={`${base}/case-studies/${s.slug}/themes/${t.file}`}
                alt={`The ${t.name} theme icon`}
                loading="lazy"
              />
              <span class="bh-theme-name">{t.name}</span>
              <span class="bh-theme-park">{t.park}</span>
              <span class="bh-theme-bar" aria-hidden="true">
                {t.swatches.map((w) => (
                  <span style={`--c:${w}`} />
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ══ 06 Product ══════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">06</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Product</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.product.lead}{h.product.accent && <em>{h.product.accent}</em>}
      </h2>
      <p class="bh-body">{s.product.note}</p>
    </div>
  </section>

  {
    s.product.screens && (
      <section class="bh-band">
        <p class="bh-sub-label reveal flush">{s.product.screens.title}</p>
        <ul class="bh-screens stagger">
          {s.product.screens.images.map((im, i) => (
            <li style={`--i:${i}`}>
              <img src={`${base}${im.src}`} alt={im.alt} loading="lazy" />
            </li>
          ))}
        </ul>
        {s.product.second && (
          <>
            <p class="bh-sub-label reveal">{s.product.second.title}</p>
            <ul class="bh-screens stagger">
              {s.product.second.images.map((im, i) => (
                <li style={`--i:${i}`}>
                  <img src={`${base}${im.src}`} alt={im.alt} loading="lazy" />
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {/* The adaptivity rebuild. */}
  {
    s.product.adaptivity && (
      <section class="bh-sec">
        <div class="bh-adapt reveal">
          <div class="bh-adapt-head">
            <p class="bh-sub-label flush">Rebuilt for adaptivity</p>
            <h3 class="bh-adapt-title">{s.product.adaptivity.title}</h3>
            <p class="bh-ct-note">{s.product.adaptivity.note}</p>
            {s.product.adaptivity.shot && (
              <img
                class="bh-adapt-shot"
                src={`${base}${s.product.adaptivity.shot.src}`}
                alt={s.product.adaptivity.shot.alt}
                loading="lazy"
              />
            )}
          </div>
          <ol class="bh-adapt-list">
            {s.product.adaptivity.points.map((p, i) => (
              <li>
                <span class="bh-adapt-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h4>{p.title}</h4>
                <p>{p.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    s.product.system && (
      <section class="bh-sec">
        <div class="bh-two reveal">
          <div>
            <p class="bh-sub-label flush">System</p>
            <h3 class="bh-sys-title">{s.product.system.title}</h3>
          </div>
          <div>
            <p class="bh-body">{s.product.system.body}</p>
            <div class="bh-sysmap">
              <p class="bh-sysmap-from">{s.product.system.from}</p>
              <ul class="bh-sysmap-to">
                {s.product.system.to.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ══ 07 Marketing ════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">07</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Marketing</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.marketing.lead}{h.marketing.accent && <em>{h.marketing.accent}</em>}
      </h2>
      <p class="bh-body">{s.marketing.note}</p>
    </div>
    <ol class="bh-timeline stagger">
      {
        s.marketing.cycle.map((c, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-tl-when">{c.when}</span>
            <span class="bh-tl-dot" aria-hidden="true" />
            <h4>{c.title}</h4>
            <p>{c.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ══ 08 Social ═══════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">08</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Social</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.social.lead}{h.social.accent && <em>{h.social.accent}</em>}
      </h2>
      <p class="bh-body">{s.social.note}</p>
    </div>

    {
      s.social.stats && (
        <ul class="bh-soc-stats stagger">
          {s.social.stats.map((st, i) => (
            <li style={`--i:${i}`}>
              <span class="bh-soc-v" data-count={st.value}>
                {st.value}
              </span>
              <span class="bh-soc-l">{st.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="bh-ct">
      <div class="bh-ct-col">
        <p class="bh-sub-label reveal flush">Strategy</p>
        <ul class="bh-strats stagger">
          {
            s.social.strategies.map((t, i) => (
              <li style={`--i:${i}`}>
                <h4>{t.title}</h4>
                <p>{t.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">{s.social.pipeline.title}</p>
        <div class="bh-pipeline">
          <svg class="bh-pipe-arrow" viewBox="0 0 60 12" aria-hidden="true">
            <path d="M0 6h52m-6-5 6 5-6 5"></path>
          </svg>
          <p>{s.social.pipeline.body}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ══ 09 Results ══════════════════════════════════════════════════════ */}
  <section class="bh-outcome reveal">
    <span class="bh-ghost small" aria-hidden="true">Results</span>
    <div class="bh-mark">
      <span class="bh-num">09</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Results</span>
    </div>
    <ul class="bh-results stagger">
      {
        s.results.stats.map((r, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-res-v" data-count={r.value}>
              {r.value}
            </span>
            <span class="bh-res-l">{r.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="bh-outcome-lede">{s.results.footer}</p>
  </section>
</article>

<script>
  // Figures count up when they scroll into view. Values like "1.5B", "533%",
  // "200+", "$75K" and "4.3" keep their prefix, suffix and decimals.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const els = document.querySelectorAll<HTMLElement>("[data-count]");

  const parse = (raw: string) => {
    const m = raw.match(/^([^\d.]*)([\d.,]+)(.*)$/);
    if (!m) return null;
    const num = Number(m[2].replace(/,/g, ""));
    if (!Number.isFinite(num)) return null;
    const dec = (m[2].split(".")[1] ?? "").length;
    const grouped = m[2].includes(",");
    return { pre: m[1], num, suf: m[3], dec, grouped };
  };

  const run = (el: HTMLElement) => {
    const parsed = parse(el.dataset.count ?? "");
    if (!parsed) return;
    const { pre, num, suf, dec, grouped } = parsed;
    const fmt = (v: number) =>
      pre +
      (dec
        ? v.toFixed(dec)
        : grouped
          ? Math.round(v).toLocaleString("en-US")
          : String(Math.round(v))) +
      suf;
    const t0 = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / 1400);
      el.textContent = fmt(num * (1 - Math.pow(1 - t, 3)));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
