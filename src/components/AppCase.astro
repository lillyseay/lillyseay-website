---
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  study: CaseStudy;
}

const { study: s } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Every band, wash and accent on the page comes from the app's own palette, so
// each case study reads like that product's landing page rather than like this site.
const theme = [
  `--from:${s.accent.from}`,
  `--mid:${s.accent.mid}`,
  `--to:${s.accent.to}`,
  `--band:${s.band.light}`,
  `--band-dk:${s.band.dark}`,
].join("; ");
---

<article class="appcase" id={s.slug} style={theme}>
  {/* ── Hero ──────────────────────────────────────────────────────────── */}
  <header class="cs-hero">
    <div class="cs-hero-wash" aria-hidden="true"></div>
    <div class="cs-hero-inner">
      {
        s.icon && (
          <img
            class="cs-hero-icon float"
            src={`${base}${s.icon}`}
            alt=""
            width="112"
            height="112"
          />
        )
      }
      <p class="cs-kicker">{s.years} · {s.status}</p>
      <h1 class="cs-title">{s.name}</h1>
      <p class="cs-lede">{s.lede}</p>
      <p class="cs-role">{s.role} · {s.platforms}</p>
      <ul class="cs-hero-stats">
        {
          s.stats.map((st, i) => (
            <li style={`--i:${i}`}>
              <span class="cs-stat-v">{st.value}</span>
              <span class="cs-stat-l">{st.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  {/* ── Inside the app ────────────────────────────────────────────────── */}
  {
    s.gallery && (
      <section class="cs-band">
        <div class="cs-band-head reveal">
          <p class="sec-kind">{s.gallery.kicker}</p>
          <h2>{s.gallery.title}</h2>
          {s.gallery.note && <p class="cs-band-note">{s.gallery.note}</p>}
        </div>
        <ul class="cs-gallery stagger">
          {s.gallery.images.map((im, i) => (
            <li style={`--i:${i}`}>
              <img src={`${base}${im.src}`} alt={im.alt} loading="lazy" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── Problem ───────────────────────────────────────────────────────── */}
  <section class="cs-sec cs-split reveal">
    <div class="cs-split-head">
      <p class="sec-kind">The problem</p>
      <h2>{s.problem.title}</h2>
    </div>
    <div class="cs-split-body">
      <p>{s.problem.body}</p>
      {
        s.problem.stat && (
          <p class="cs-bigstat">
            <strong>{s.problem.stat.value}</strong>
            <span>{s.problem.stat.label}</span>
          </p>
        )
      }
    </div>
  </section>

  {/* ── Role ──────────────────────────────────────────────────────────── */}
  <section class="cs-sec cs-split reveal">
    <div class="cs-split-head">
      <p class="sec-kind">My role</p>
      <h2>{s.role}</h2>
    </div>
    <div class="cs-split-body">
      <p>{s.myRole.body}</p>
      <ul class="cs-chips">
        {s.myRole.owned.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  {/* ── Research ──────────────────────────────────────────────────────── */}
  <section class="cs-sec cs-split reveal">
    <div class="cs-split-head">
      <p class="sec-kind">Research</p>
      <h2>{s.research.title}</h2>
    </div>
    <div class="cs-split-body">
      <p>{s.research.body}</p>
    </div>
  </section>

  {
    s.research.quotes && (
      <section class="cs-sec cs-bleed">
        <ul class="quote-wall stagger">
          {s.research.quotes.map((q, i) => (
            <li style={`--i:${i}`}>
              <blockquote>{q.text}</blockquote>
              <cite>{q.meta}</cite>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    s.research.findings && (
      <section class="cs-sec reveal">
        <p class="sec-kind">Signal in, feature out</p>
        <ol class="cs-findings stagger">
          {s.research.findings.map((f, i) => (
            <li style={`--i:${i}`}>
              <span class="cs-find-signal">{f.signal}</span>
              <span class="cs-find-arrow" aria-hidden="true" />
              <span class="cs-find-shipped">{f.shipped}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* ── Strategy ──────────────────────────────────────────────────────── */}
  <section class="cs-sec cs-statement reveal">
    <p class="sec-kind">Design strategy</p>
    <h2>{s.strategy.title}</h2>
    <p>{s.strategy.body}</p>
  </section>

  {/* ── The cast ──────────────────────────────────────────────────────── */}
  {
    s.characters && (
      <section class="cs-band">
        <div class="cs-band-head reveal">
          <p class="sec-kind">The cast</p>
          <h2>{s.characters.heading}</h2>
          <p class="cs-band-note">{s.characters.note}</p>
        </div>
        <ul class="cs-cast stagger">
          {s.characters.list.map((c, i) => (
            <li style={`--i:${i}; --a:${c.hex}; --b:${c.to}`}>
              <span class="cs-cast-art">
                <img
                  src={`${base}/case-studies/${s.slug}/buddies/${c.file}`}
                  alt={`${c.name}, ${c.role}`}
                  loading="lazy"
                />
              </span>
              <span class="cs-cast-name">{c.name}</span>
              <span class="cs-cast-role">{c.role}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── Themes ────────────────────────────────────────────────────────── */}
  {
    s.themes && (
      <section class="cs-sec">
        <div class="cs-band-head plain reveal">
          <p class="sec-kind">Themes</p>
          <h2>{s.themes.heading}</h2>
          <p class="cs-band-note">{s.themes.note}</p>
        </div>
        <ul class="cs-themes stagger">
          {s.themes.list.map((t, i) => (
            <li style={`--i:${i}`}>
              <img
                class="cs-theme-icon"
                src={`${base}/case-studies/${s.slug}/themes/${t.file}`}
                alt={`The ${t.name} theme icon`}
                loading="lazy"
              />
              <span class="cs-theme-name">{t.name}</span>
              <span class="cs-theme-park">{t.park}</span>
              <span class="cs-theme-bar" aria-hidden="true">
                {t.swatches.map((w) => (
                  <span style={`--c:${w}`} />
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── Palette ───────────────────────────────────────────────────────── */}
  <section class="cs-sec">
    <div class="cs-band-head plain reveal">
      <p class="sec-kind">Colour</p>
      <h2>The palette, and what it has to survive</h2>
      <p class="cs-band-note">{s.palette.intro}</p>
    </div>
    <div class="palette">
      {
        s.palette.groups.map((g) => (
          <div class="palette-group reveal">
            <h4>{g.name}</h4>
            <p class="palette-note">{g.note}</p>
            <ul class="swatches stagger">
              {g.swatches.map((w, i) => (
                <li style={`--i:${i}`}>
                  <span class="chip" style={`--chip:${w.hex}`} aria-hidden="true" />
                  <span class="chip-hex">{w.hex}</span>
                  <span class="chip-name">{w.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    {s.palette.type && <p class="palette-type reveal">{s.palette.type}</p>}
  </section>

  {/* ── Second run of screens ─────────────────────────────────────────── */}
  {
    s.marketingShots && (
      <section class="cs-band">
        <div class="cs-band-head reveal">
          <p class="sec-kind">{s.marketingShots.kicker}</p>
          <h2>{s.marketingShots.title}</h2>
          {s.marketingShots.note && (
            <p class="cs-band-note">{s.marketingShots.note}</p>
          )}
        </div>
        <ul class="cs-gallery stagger">
          {s.marketingShots.images.map((im, i) => (
            <li style={`--i:${i}`}>
              <img src={`${base}${im.src}`} alt={im.alt} loading="lazy" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── Systems ───────────────────────────────────────────────────────── */}
  <section class="cs-sec cs-split reveal">
    <div class="cs-split-head">
      <p class="sec-kind">Systems</p>
      <h2>{s.systems.title}</h2>
    </div>
    <div class="cs-split-body">
      <p>{s.systems.body}</p>
    </div>
  </section>

  {
    s.systems.diagram && (
      <section class="cs-sec reveal">
        <div class="sysmap">
          <p class="sysmap-from">{s.systems.diagram.from}</p>
          <ul class="sysmap-to stagger">
            {s.systems.diagram.to.map((t, i) => (
              <li style={`--i:${i}`}>{t}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* ── Decisions ─────────────────────────────────────────────────────── */}
  <section class="cs-sec">
    <p class="sec-kind reveal">Design decisions</p>
    <ol class="decision-list stagger">
      {
        s.decisions.map((d, i) => (
          <li style={`--i:${i}`}>
            <h4>{d.title}</h4>
            <p>{d.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── Marketing ─────────────────────────────────────────────────────── */}
  <section class="cs-sec cs-split reveal">
    <div class="cs-split-head">
      <p class="sec-kind">Marketing</p>
      <h2>How it got downloaded</h2>
    </div>
    <div class="cs-split-body">
      <p>{s.marketing.body}</p>
    </div>
  </section>
  <section class="cs-sec">
    <ul class="channel-list stagger">
      {
        s.marketing.channels.map((c, i) => (
          <li style={`--i:${i}`}>
            <h4>{c.name}</h4>
            <p>{c.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── Outcome ───────────────────────────────────────────────────────── */}
  <section class="cs-outcome reveal">
    <p class="sec-kind">Outcome</p>
    <p class="cs-outcome-lede">{s.outcome.body}</p>
    <ul class="win-list stagger">
      {s.outcome.wins.map((w, i) => <li style={`--i:${i}`}>{w}</li>)}
    </ul>
  </section>
</article>
