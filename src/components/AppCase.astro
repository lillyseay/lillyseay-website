---
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  study: CaseStudy;
}

const { study: s } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Headings carry a single "|". Everything after it renders in the app's accent.
const split = (t: string) => {
  const [lead, accent] = t.split("|");
  return { lead: lead.trim(), accent: accent?.trim() };
};

const theme = [
  `--from:${s.accent.from}`,
  `--mid:${s.accent.mid}`,
  `--to:${s.accent.to}`,
  `--band:${s.band.light}`,
  `--band-dk:${s.band.dark}`,
].join("; ");

// Section numbers are derived, not written down: a study without a founder
// story starts at Problem and everything below it shifts up by one.
const order = [
  ...(s.story ? ["story"] : []),
  "problem",
  "research",
  "strategy",
  "identity",
  "ux",
  "product",
  ...(s.marketing ? ["marketing"] : []),
  ...(s.social ? ["social"] : []),
  "results",
];
const no = (k: string) => String(order.indexOf(k) + 1).padStart(2, "0");

const h = {
  ...(s.story ? { story: split(s.story.heading) } : {}),
  ...(s.marketing ? { marketing: split(s.marketing.heading) } : {}),
  ...(s.social ? { social: split(s.social.heading) } : {}),
  problem: split(s.problem.heading),
  research: split(s.research.heading),
  strategy: split(s.strategy.heading),
  ux: split(s.ux.heading),
  identity: split(s.identity.heading),
  product: split(s.product.heading),
};
---

<article class="bh" id={s.slug} style={theme}>
  {/* ══ Hero and overview ═══════════════════════════════════════════════ */}
  <div class="bh-meta reveal">
    <span>{s.category}</span>
    <span>Design case study</span>
    <span>{s.years}</span>
  </div>

  <header class="bh-hero">
    <div class="bh-hero-top">
      {
        s.icon && (
          <img
            class="bh-hero-icon"
            src={`${base}${s.icon}`}
            alt=""
            width="112"
            height="112"
          />
        )
      }
      <div class="bh-hero-words">
        <h1 class="bh-title">{s.name}</h1>
        <p class="bh-lede">{s.lede}</p>
        {
          s.badges && (
            <ul class="bh-hero-badges">
              {s.badges.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </header>

  <section class="bh-overview">
    <ul class="bh-ov-stats stagger">
      {
        s.overview.stats.map((st, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-ov-v" data-count={st.value}>
              {st.value}
            </span>
            <span class="bh-ov-l">{st.label}</span>
          </li>
        ))
      }
    </ul>
    <dl class="bh-facts reveal">
      {
        s.overview.facts.map((f) => (
          <div>
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    s.story && (
      <section class="bh-sec">
        <div class="bh-mark reveal">
          <span class="bh-num">{no("story")}</span>
          <span class="bh-rule" aria-hidden="true" />
          <span class="bh-label">The story</span>
        </div>
        <h2 class="bh-h2 bh-h2-wide reveal">
          {h.story!.lead}
          {h.story!.accent && <em>{h.story!.accent}</em>}
        </h2>
        <ol class="bh-story stagger">
          {s.story.beats.map((b, i) => (
            <li style={`--i:${i}`}>
              <span class="bh-story-n" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* ══ Problem ══════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{no("problem")}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Problem</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.problem.lead}{h.problem.accent && <em>{h.problem.accent}</em>}
      </h2>
      <p class="bh-body">{s.problem.note}</p>
    </div>
    {
      s.problem.scale && (
        <ul class="bh-scale stagger">
          {s.problem.scale.map((a, i) => (
            <li style={`--i:${i}`}>
              <span class="bh-scale-v" data-count={a.value}>
                {a.value}
              </span>
              <span class="bh-scale-l">{a.label}</span>
              {a.source && <span class="bh-scale-src">{a.source}</span>}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ══ Research ═════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{no("research")}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Research</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.research.lead}{h.research.accent && <em>{h.research.accent}</em>}
      </h2>
      <p class="bh-body">{s.research.note}</p>
    </div>

    {
      s.research.quotes && (
        <>
          <p class="bh-sub-label reveal">What people said back</p>
          <div
            class="bh-tcarousel reveal"
            style={`--n:${s.research.quotes.length}`}
          >
            <ul class="bh-ttrack">
              {/* The list is rendered twice so the loop has no seam. The second
                  copy is decorative, so it is hidden from assistive tech. */}
              {[0, 1].map((copy) =>
                s.research.quotes!.map((q) => (
                  <li aria-hidden={copy === 1 ? "true" : undefined}>
                    <blockquote>{q.text}</blockquote>
                    <footer>
                      <span class="bh-t-av" aria-hidden="true">
                        {q.user.replace(/^@/, "").charAt(0).toUpperCase()}
                      </span>
                      <span class="bh-t-name">{q.user}</span>
                      <span class="bh-t-meta">
                        {q.likes.toLocaleString("en-US")} likes
                        {q.replies
                          ? ` · ${q.replies} ${q.replies === 1 ? "reply" : "replies"}`
                          : ""}
                      </span>
                    </footer>
                  </li>
                )),
              )}
            </ul>
          </div>
        </>
      )
    }

    {
      s.research.pullQuote && (
        <figure class="bh-pull reveal">
          <span class="bh-quote-mark" aria-hidden="true">
            //
          </span>
          <blockquote>{s.research.pullQuote.text}</blockquote>
          <figcaption>{s.research.pullQuote.cite}</figcaption>
        </figure>
      )
    }

    {
      s.research.preTest && (
        <div class="bh-pretest reveal">
          <div class="bh-pretest-head">
            <p class="bh-sub-label flush">Pre-launch audience test</p>
            <h3 class="bh-pretest-title">{s.research.preTest.title}</h3>
            <p class="bh-ct-note">{s.research.preTest.note}</p>
            <ul class="bh-pretest-stats">
              {s.research.preTest.stats.map((st) => (
                <li>
                  <span class="bh-pretest-v" data-count={st.value}>
                    {st.value}
                  </span>
                  <span class="bh-pretest-l">{st.label}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="bh-pretest-chart">
            <p class="bh-pretest-cap">Views per post, best first</p>
            <ul>
              {s.research.preTest.posts.map((post) => {
                const max = Math.max(
                  ...s.research.preTest!.posts.map((x) => x.views),
                );
                const pct = Math.max((post.views / max) * 100, 3);
                return (
                  <li>
                    <span class="bh-pt-row">
                      <span class="bh-pt-title">{post.title}</span>
                      <span class="bh-pt-views">
                        {post.views.toLocaleString("en-US")}
                      </span>
                    </span>
                    <span class="bh-pt-bar" aria-hidden="true">
                      <span style={`--pct:${pct}%`} />
                    </span>
                    {post.flag && <span class="bh-pt-flag">{post.flag}</span>}
                  </li>
                );
              })}
            </ul>
            <p class="bh-pretest-foot">{s.research.preTest.footer}</p>
          </div>
        </div>
      )
    }

    {
      s.research.series && (
        <div class="bh-series reveal">
          <div class="bh-series-head">
            <p class="bh-sub-label flush">The formats</p>
            <h3 class="bh-series-title">{s.research.series.title}</h3>
            <p class="bh-ct-note">{s.research.series.note}</p>
          </div>
          <ol class="bh-series-list">
            {s.research.series.list.map((v, i) => (
              <li>
                <span class="bh-series-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h4>{v.name}</h4>
                <p class="bh-series-tests">{v.tests}</p>
                <p class="bh-series-result">
                  <span>What it told us</span>
                  {v.result}
                </p>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      s.research.findings && (
        <>
          <p class="bh-sub-label reveal">
            Pain points identified
            <span class="bh-sub-count">
              {new Set(s.research.findings.flatMap((f) => f.pains)).size}
            </span>
          </p>
          <ol class="bh-pain stagger">
            {s.research.findings.map((f, i) => (
              <li style={`--i:${i}`}>
                <span class="bh-pain-n" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <details>
                  <summary>
                    <span class="bh-pain-f">
                      <span class="bh-pain-lab">Feature</span>
                      <span class="bh-pain-t">{f.feature}</span>
                    </span>
                    <span class="bh-pain-f">
                      <span class="bh-pain-lab">
                        Inspired by {f.pains.length > 1 && f.pains.length}
                        {f.pains.length > 1 && " pain points"}
                      </span>
                      <span class="bh-pain-pills">
                        {f.pains.map((q) => (
                          <span class="bh-pain-pill">{q}</span>
                        ))}
                      </span>
                    </span>
                    <span class="bh-pain-chev" aria-hidden="true" />
                  </summary>
                  <p class="bh-pain-why">{f.why}</p>
                </details>
              </li>
            ))}
          </ol>
        </>
      )
    }

    {
      s.research.audiences && (
        <>
          <p class="bh-sub-label reveal">Adjacent target audiences</p>
          <ul class="bh-audchips stagger">
            {s.research.audiences.map((a, i) => (
              <li style={`--i:${i}`}>{a.name}</li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  {/* ══ Product strategy ═════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{no("strategy")}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Product strategy</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.strategy.lead}{h.strategy.accent && <em>{h.strategy.accent}</em>}
      </h2>
      <p class="bh-body">{s.strategy.note}</p>
    </div>
    <ol class="bh-bets stagger">
      {
        s.strategy.bets.map((b, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-bet-num">{String(i + 1).padStart(2, "0")}</span>
            <h4>{b.title}</h4>
            <p>{b.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ══ Visual identity ══════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{no("identity")}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Visual identity</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.identity.lead}{h.identity.accent && <em>{h.identity.accent}</em>}
      </h2>
      <p class="bh-body">{s.identity.note}</p>
    </div>

    <div class="bh-ct">
      {
        s.identity.palette && (
          <div class="bh-ct-col reveal">
            <p class="bh-sub-label flush">Color</p>
            <p class="bh-ct-note">{s.identity.palette.note}</p>
            {s.identity.palette.groups.map((g) => (
              <div class="bh-pal-row">
                <p class="bh-pal-name">{g.name}</p>
                <ul class="bh-chipset">
                  {g.swatches.map((w) => (
                    <li style={`--c:${w.hex}`}>
                      <span class="bh-chip" aria-hidden="true" />
                      <span class="bh-chip-hex">{w.hex}</span>
                      <span class="bh-chip-name">{w.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">Typography</p>
        <p class="bh-ct-note">{s.identity.typography.note}</p>
        <ul class="bh-faces">
          {
            s.identity.typography.faces.map((f) => (
              <li>
                <span class="bh-face-sample" aria-hidden="true">
                  {f.sample}
                </span>
                <div>
                  <p class="bh-face-name">{f.name}</p>
                  <p class="bh-face-role">{f.role}</p>
                  <p class="bh-face-detail">{f.detail}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    s.identity.characters && (
      <section class="bh-band">
        <p class="bh-sub-label reveal flush">{s.identity.characters.title}</p>
        <p class="bh-body wide reveal">{s.identity.characters.note}</p>
        <div
          class="bh-castwrap reveal"
          style={`--n:${s.identity.characters.list.length}`}
        >
          <ul class="bh-cast">
            {/* Two copies, so the loop has no seam. */}
            {[0, 1].map((copy) =>
              s.identity.characters!.list.map((c) => (
                <li
                  style={`--a:${c.hex}; --b:${c.to}`}
                  aria-hidden={copy === 1 ? "true" : undefined}
                >
                  <span class="bh-cast-art">
                    <img
                      src={`${base}/case-studies/${s.slug}/buddies/${c.file}`}
                      alt={`${c.name}, ${c.role}`}
                      loading="lazy"
                    />
                  </span>
                  <span class="bh-cast-name">{c.name}</span>
                  <span class="bh-cast-role">{c.role}</span>
                  <span class="bh-cast-bar" aria-hidden="true">
                    {[...new Set(c.swatches ?? [c.hex, c.to])].map((w) => (
                      <span style={`--c:${w}`} />
                    ))}
                  </span>
                </li>
              )),
            )}
          </ul>
        </div>
      </section>
    )
  }

  {
    s.identity.themes && (
      <section class="bh-sec">
        <p class="bh-sub-label reveal flush">{s.identity.themes.title}</p>
        <p class="bh-body wide reveal">{s.identity.themes.note}</p>
        <ul class="bh-themes stagger">
          {s.identity.themes.list.map((t, i) => (
            <li style={`--i:${i}`}>
              <img
                src={`${base}/case-studies/${s.slug}/themes/${t.file}`}
                alt={`The ${t.name} theme icon`}
                loading="lazy"
              />
              <span class="bh-theme-name">{t.name}</span>
              <span class="bh-theme-park">{t.park}</span>
              <span class="bh-theme-bar" aria-hidden="true">
                {t.swatches.map((w) => (
                  <span style={`--c:${w}`} />
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ══ UX ═══════════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{no("ux")}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">UX</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.ux.lead}{h.ux.accent && <em>{h.ux.accent}</em>}
      </h2>
      <p class="bh-body">{s.ux.note}</p>
    </div>

    {
      s.ux.anatomy && (
        <div
          class={`bh-anatomy reveal${s.ux.anatomy.states ? " is-states" : ""}`}
        >
          <div class="bh-anatomy-shot">
            {s.ux.anatomy.states ? (
              <ol class="bh-states">
                {s.ux.anatomy.states.map((st, i) => (
                  <li>
                    <img src={`${base}${st.src}`} alt={st.alt} loading="lazy" />
                    <p class="bh-state-label">
                      <span aria-hidden="true">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      {st.label}
                    </p>
                    <p class="bh-state-caption">{st.caption}</p>
                  </li>
                ))}
              </ol>
            ) : (
              s.ux.anatomy.shot && (
                <img
                  src={`${base}${s.ux.anatomy.shot.src}`}
                  alt={s.ux.anatomy.shot.alt}
                  loading="lazy"
                />
              )
            )}
          </div>
          <div class="bh-anatomy-key">
            <p class="bh-sub-label flush">{s.ux.anatomy.label ?? "Anatomy"}</p>
            {s.ux.anatomy.title && (
              <h3 class="bh-anatomy-title">{s.ux.anatomy.title}</h3>
            )}
            <p class="bh-ct-note">{s.ux.anatomy.note}</p>
            {s.ux.anatomy.checklist && (
              <ul class="bh-checklist">
                {s.ux.anatomy.checklist.map((c) => (
                  <li>
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M3.5 8.5l3 3 6-7" />
                    </svg>
                    {c}
                  </li>
                ))}
              </ul>
            )}
            {s.ux.anatomy.parts && (
              <ul class="bh-parts">
                {s.ux.anatomy.parts.map((p) => (
                  <li>
                    <p class="bh-part-name">{p.name}</p>
                    <p class="bh-part-detail">{p.detail}</p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      )
    }

    {
      s.ux.rules && (
        <>
          <p class="bh-sub-label reveal">Interaction rules</p>
          <ul class="bh-rules stagger">
            {s.ux.rules.map((r, i) => (
              <li style={`--i:${i}`}>
                <h4>{r.title}</h4>
                <p>{r.body}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {/* The adaptivity rebuild. */}
    {
      s.ux.adaptivity && (
        <div class="bh-adapt reveal">
          <div class="bh-adapt-head">
            <p class="bh-sub-label flush">Rebuilt for adaptivity</p>
            <h3 class="bh-adapt-title">
              {split(s.ux.adaptivity.title).lead}
              {split(s.ux.adaptivity.title).accent && (
                <em>{split(s.ux.adaptivity.title).accent}</em>
              )}
            </h3>
          </div>
          {s.ux.adaptivity.shot && (
            <img
              class="bh-adapt-shot"
              src={`${base}${s.ux.adaptivity.shot.src}`}
              alt={s.ux.adaptivity.shot.alt}
              loading="lazy"
            />
          )}
          <div class="bh-adapt-side">
            <p class="bh-ct-note bh-adapt-note">{s.ux.adaptivity.note}</p>
            {s.ux.adaptivity.checklist ? (
              <ul class="bh-checklist bh-adapt-checks">
                {s.ux.adaptivity.checklist.map((c) => (
                  <li>
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M3.5 8.5l3 3 6-7" />
                    </svg>
                    {c}
                  </li>
                ))}
              </ul>
            ) : (
              s.ux.adaptivity.points && (
                <ol class="bh-adapt-list">
                  {s.ux.adaptivity.points.map((p, i) => (
                    <li>
                      <span class="bh-adapt-num" aria-hidden="true">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <h4>{p.title}</h4>
                      <p>{p.body}</p>
                    </li>
                  ))}
                </ol>
              )
            )}
          </div>
        </div>
      )
    }
  </section>

  {/* ══ Product ══════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{no("product")}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Product</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {h.product.lead}{h.product.accent && <em>{h.product.accent}</em>}
      </h2>
      <p class="bh-body">{s.product.note}</p>
    </div>
    {
      s.product.devices && (
        <>
          <p class="bh-sub-label reveal">{s.product.devices.title}</p>
          <ul class="bh-devices stagger">
            {s.product.devices.list.map((d, i) => (
              <li style={`--i:${i}`}>
                <span class="bh-device-name">{d.name}</span>
                <span class="bh-device-role">{d.role}</span>
                <p class="bh-device-detail">{d.detail}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }
    {
      s.product.comingSoon && (
        <div class="bh-soon reveal">
          <div>
            <p class="bh-sub-label flush">{s.product.comingSoon.label}</p>
            <h3 class="bh-soon-title">{s.product.comingSoon.title}</h3>
            <p class="bh-ct-note">{s.product.comingSoon.note}</p>
          </div>
          <ul class="bh-soon-quotes">
            {s.product.comingSoon.quotes.map((q) => (
              <li>
                <blockquote>{q.text}</blockquote>
                <footer>{q.user}</footer>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  {
    s.product.screens && (
      <section class="bh-band">
        <p class="bh-sub-label reveal flush">{s.product.screens.title}</p>
        <ul class="bh-screens stagger">
          {s.product.screens.images.map((im, i) => (
