---
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  study: CaseStudy;
}

const { study: s } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Headings carry a single "|". Everything after it renders in the app's accent.
const split = (t: string) => {
  const [lead, accent] = t.split("|");
  return { lead: lead.trim(), accent: accent?.trim() };
};

const theme = [
  `--from:${s.accent.from}`,
  `--mid:${s.accent.mid}`,
  `--to:${s.accent.to}`,
  `--band:${s.band.light}`,
  `--band-dk:${s.band.dark}`,
].join("; ");

const audienceT = s.audience && split(s.audience.heading);
const researchT = split(s.research.heading);
const designT = split(s.design.heading);
const marketingT = split(s.marketing.heading);

// Sections number in order, skipping any the app does not have.
let n = 0;
const step = () => String(++n).padStart(2, "0");
const nAudience = s.audience ? step() : null;
const nResearch = step();
const nDesign = step();
const nMarketing = step();
---

<article class="bh" id={s.slug} style={theme}>
  {/* ══ Hero and overview ═══════════════════════════════════════════════ */}
  <div class="bh-meta reveal">
    <span>{s.category}</span>
    <span>Design case study</span>
    <span>{s.years}</span>
  </div>

  <header class="bh-hero">
    <span class="bh-ghost" aria-hidden="true">{s.name}</span>
    <svg class="bh-arc" viewBox="0 0 400 400" aria-hidden="true">
      <circle cx="200" cy="200" r="198"></circle>
      <circle cx="200" cy="200" r="150"></circle>
    </svg>
    <div class="bh-hero-inner">
      {
        s.icon && (
          <img
            class="bh-hero-icon float"
            src={`${base}${s.icon}`}
            alt=""
            width="112"
            height="112"
          />
        )
      }
      <h1 class="bh-title">{s.name}</h1>
      <p class="bh-lede">{s.lede}</p>
      <p class="bh-status">{s.status}</p>
    </div>
  </header>

  <section class="bh-overview">
    <ul class="bh-ov-stats stagger">
      {
        s.overview.stats.map((st, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-ov-v" data-count={st.value}>
              {st.value}
            </span>
            <span class="bh-ov-l">{st.label}</span>
          </li>
        ))
      }
    </ul>
    <div class="bh-ov-two reveal">
      <dl class="bh-facts">
        {
          s.overview.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="bh-ov-problem">
        <p class="bh-label solo">The problem</p>
        <p>{s.overview.problem}</p>
      </div>
    </div>
  </section>

  {/* ══ Target audience ═════════════════════════════════════════════════ */}
  {
    s.audience && audienceT && (
      <section class="bh-sec">
        <div class="bh-mark reveal">
          <span class="bh-num">{nAudience}</span>
          <span class="bh-rule" aria-hidden="true" />
          <span class="bh-label">Target audience</span>
        </div>
        <h2 class="bh-h2 reveal">
          {audienceT.lead}
          {audienceT.accent && <em>{audienceT.accent}</em>}
        </h2>
        <p class="bh-body wide reveal">{s.audience.note}</p>

        <ul class="bh-aud-primary stagger">
          {s.audience.primary.map((a, i) => (
            <li style={`--i:${i}`}>
              <span class="bh-aud-v" data-count={a.value}>
                {a.value}
              </span>
              <span class="bh-aud-l">{a.label}</span>
              <span class="bh-aud-src">{a.source}</span>
            </li>
          ))}
        </ul>

        <ul class="bh-aud-list stagger">
          {s.audience.adjacent.map((a, i) => (
            <li style={`--i:${i}`}>
              <span class="bh-aud-dot" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h4>{a.name}</h4>
              <p>{a.detail}</p>
              <p class="bh-aud-ev">{a.evidence}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ══ User research ═══════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{nResearch}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">User research</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {researchT.lead}{researchT.accent && <em>{researchT.accent}</em>}
      </h2>
      <p class="bh-body">{s.research.note}</p>
    </div>

    {
      s.research.quotes && (
        <div class="bh-comments-wrap">
          <p class="bh-comments-head reveal">
            <span>{s.research.quotes.length} comments</span>
            <small>@hearingbuddy · TikTok</small>
          </p>
          <ul class="bh-comments stagger">
            {s.research.quotes.map((q, i) => (
              <li style={`--i:${i}`}>
                <span class="bh-av" aria-hidden="true">
                  {q.user.replace(/^@/, "").charAt(0).toUpperCase()}
                </span>
                <div class="bh-c-body">
                  <p class="bh-c-user">{q.user}</p>
                  <p class="bh-c-text">{q.text}</p>
                  <p class="bh-c-foot">
                    <span>{q.date}</span>
                    <span>Reply</span>
                    {q.replies ? (
                      <span>
                        View {q.replies} {q.replies === 1 ? "reply" : "replies"}
                      </span>
                    ) : null}
                  </p>
                </div>
                <span class="bh-c-like">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21s-7.5-4.6-9.6-9A5.2 5.2 0 0 1 12 6.6 5.2 5.2 0 0 1 21.6 12c-2.1 4.4-9.6 9-9.6 9z" />
                  </svg>
                  <em>{q.likes}</em>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      s.research.pullQuote && (
        <figure class="bh-pull reveal">
          <span class="bh-quote-mark" aria-hidden="true">
            //
          </span>
          <blockquote>{s.research.pullQuote.text}</blockquote>
          <figcaption>{s.research.pullQuote.cite}</figcaption>
        </figure>
      )
    }

    {
      s.research.findings && (
        <>
          <p class="bh-sub-label reveal">Pain points identified</p>
          <div class="bh-hub reveal">
            <div class="bh-hub-core">
              <span>{s.research.findings.length}</span>
              <small>pain points</small>
            </div>
            <ul class="bh-hub-list stagger">
              {s.research.findings.map((f, i) => (
                <li style={`--i:${i}`}>
                  <span class="bh-hub-dot" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <h4>{f.signal}</h4>
                  <p>{f.shipped}</p>
                </li>
              ))}
            </ul>
          </div>
        </>
      )
    }
  </section>

  {/* ══ Design ══════════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{nDesign}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Design</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {designT.lead}{designT.accent && <em>{designT.accent}</em>}
      </h2>
      <p class="bh-body">{s.design.note}</p>
    </div>
  </section>

  {
    s.design.screens && (
      <section class="bh-band">
        <p class="bh-sub-label reveal flush">{s.design.screens.title}</p>
        <ul class="bh-screens stagger">
          {s.design.screens.images.map((im, i) => (
            <li style={`--i:${i}`}>
              <img src={`${base}${im.src}`} alt={im.alt} loading="lazy" />
            </li>
          ))}
        </ul>
        {s.design.second && (
          <>
            <p class="bh-sub-label reveal">{s.design.second.title}</p>
            <ul class="bh-screens stagger">
              {s.design.second.images.map((im, i) => (
                <li style={`--i:${i}`}>
                  <img src={`${base}${im.src}`} alt={im.alt} loading="lazy" />
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {/* Colour and type, side by side and compact. */}
  <section class="bh-sec">
    <div class="bh-ct">
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">Colour</p>
        <p class="bh-ct-note">{s.design.palette.note}</p>
        {
          s.design.palette.groups.map((g) => (
            <div class="bh-pal-row">
              <p class="bh-pal-name">{g.name}</p>
              <ul class="bh-chipset">
                {g.swatches.map((w) => (
                  <li style={`--c:${w.hex}`}>
                    <span class="bh-chip" aria-hidden="true" />
                    <span class="bh-chip-hex">{w.hex}</span>
                    <span class="bh-chip-name">{w.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">Typography</p>
        <p class="bh-ct-note">{s.design.typography.note}</p>
        <ul class="bh-faces">
          {
            s.design.typography.faces.map((f) => (
              <li>
                <span class="bh-face-sample" aria-hidden="true">
                  {f.sample}
                </span>
                <div>
                  <p class="bh-face-name">{f.name}</p>
                  <p class="bh-face-role">{f.role}</p>
                  <p class="bh-face-detail">{f.detail}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* The cast, over their own gradients. */}
  {
    s.design.characters && (
      <section class="bh-band">
        <p class="bh-sub-label reveal flush">{s.design.characters.title}</p>
        <p class="bh-body wide reveal">{s.design.characters.note}</p>
        <ul class="bh-cast stagger">
          {s.design.characters.list.map((c, i) => (
            <li style={`--i:${i}; --a:${c.hex}; --b:${c.to}`}>
              <span class="bh-cast-art">
                <img
                  src={`${base}/case-studies/${s.slug}/buddies/${c.file}`}
                  alt={`${c.name}, ${c.role}`}
                  loading="lazy"
                />
              </span>
              <span class="bh-cast-name">{c.name}</span>
              <span class="bh-cast-role">{c.role}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Park themes. */}
  {
    s.design.themes && (
      <section class="bh-sec">
        <p class="bh-sub-label reveal flush">{s.design.themes.title}</p>
        <p class="bh-body wide reveal">{s.design.themes.note}</p>
        <ul class="bh-themes stagger">
          {s.design.themes.list.map((t, i) => (
            <li style={`--i:${i}`}>
              <img
                src={`${base}/case-studies/${s.slug}/themes/${t.file}`}
                alt={`The ${t.name} theme icon`}
                loading="lazy"
              />
              <span class="bh-theme-name">{t.name}</span>
              <span class="bh-theme-park">{t.park}</span>
              <span class="bh-theme-bar" aria-hidden="true">
                {t.swatches.map((w) => (
                  <span style={`--c:${w}`} />
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Decisions and the system, side by side. */}
  <section class="bh-sec">
    <div class="bh-ct">
      <div class="bh-ct-col">
        <p class="bh-sub-label reveal flush">Design decisions</p>
        <ol class="bh-decisions stagger">
          {
            s.design.decisions.map((d, i) => (
              <li style={`--i:${i}`}>
                <span class="bh-dec-num">{String(i + 1).padStart(2, "0")}</span>
                <h4>{d.title}</h4>
                <p>{d.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      {
        s.design.system && (
          <div class="bh-ct-col reveal">
            <p class="bh-sub-label flush">System</p>
            <h4 class="bh-sys-title">{s.design.system.title}</h4>
            <p class="bh-ct-note">{s.design.system.body}</p>
            <div class="bh-sysmap">
              <p class="bh-sysmap-from">{s.design.system.from}</p>
              <ul class="bh-sysmap-to">
                {s.design.system.to.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* ══ Marketing ═══════════════════════════════════════════════════════ */}
  <section class="bh-sec">
    <div class="bh-mark reveal">
      <span class="bh-num">{nMarketing}</span>
      <span class="bh-rule" aria-hidden="true"></span>
      <span class="bh-label">Marketing</span>
    </div>
    <div class="bh-two reveal">
      <h2 class="bh-h2">
        {marketingT.lead}{marketingT.accent && <em>{marketingT.accent}</em>}
      </h2>
      <p class="bh-body">{s.marketing.note}</p>
    </div>

    <p class="bh-sub-label reveal">The cycle</p>
    <ol class="bh-timeline stagger">
      {
        s.marketing.cycle.map((c, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-tl-when">{c.when}</span>
            <span class="bh-tl-dot" aria-hidden="true" />
            <h4>{c.title}</h4>
            <p>{c.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="bh-ct">
      <div class="bh-ct-col">
        <p class="bh-sub-label reveal flush">Social strategy</p>
        <ul class="bh-strats stagger">
          {
            s.marketing.strategies.map((t, i) => (
              <li style={`--i:${i}`}>
                <h4>{t.title}</h4>
                <p>{t.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="bh-ct-col reveal">
        <p class="bh-sub-label flush">{s.marketing.pipeline.title}</p>
        <div class="bh-pipeline">
          <svg class="bh-pipe-arrow" viewBox="0 0 60 12" aria-hidden="true">
            <path d="M0 6h52m-6-5 6 5-6 5"></path>
          </svg>
          <p>{s.marketing.pipeline.body}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ══ Results ═════════════════════════════════════════════════════════ */}
  <section class="bh-outcome reveal">
    <span class="bh-ghost small" aria-hidden="true">Results</span>
    <p class="bh-label">Results</p>
    <ul class="bh-results stagger">
      {
        s.marketing.results.map((r, i) => (
          <li style={`--i:${i}`}>
            <span class="bh-res-v" data-count={r.value}>
              {r.value}
            </span>
            <span class="bh-res-l">{r.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="bh-outcome-lede">{s.marketing.footer}</p>
  </section>
</article>

<script>
  // Figures count up when they scroll into view. Values like "1.5B", "533%",
  // "200+", "$75K" and "4.3" keep their prefix, suffix and decimals.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const els = document.querySelectorAll<HTMLElement>("[data-count]");

  const parse = (raw: string) => {
    const m = raw.match(/^([^\d.]*)([\d.,]+)(.*)$/);
    if (!m) return null;
    const num = Number(m[2].replace(/,/g, ""));
    if (!Number.isFinite(num)) return null;
    const dec = (m[2].split(".")[1] ?? "").length;
    const grouped = m[2].includes(",");
    return { pre: m[1], num, suf: m[3], dec, grouped };
  };

  const run = (el: HTMLElement) => {
    const parsed = parse(el.dataset.count ?? "");
    if (!parsed) return;
    const { pre, num, suf, dec, grouped } = parsed;
    const fmt = (v: number) =>
      pre +
      (dec
        ? v.toFixed(dec)
        : grouped
          ? Math.round(v).toLocaleString("en-US")
          : String(Math.round(v))) +
      suf;
    const t0 = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / 1400);
      el.textContent = fmt(num * (1 - Math.pow(1 - t, 3)));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
