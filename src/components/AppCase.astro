<script>
  // Figures count up when they scroll into view. Values like "1.5B", "533%",
  // "200+", "$75K" and "4.3" keep their prefix, suffix and decimals.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const els = document.querySelectorAll<HTMLElement>("[data-count]");

  const parse = (raw: string) => {
    const m = raw.match(/^([^\d.]*)([\d.,]+)(.*)$/);
    if (!m) return null;
    // A second number means this is a phrase, not a figure: "1 in 4" would
    // otherwise animate as "0 in 4" all the way up. An ordinal is the same
    // problem, counting through "0nd" and "1nd" to reach "2nd".
    if (/\d/.test(m[3])) return null;
    if (/^(st|nd|rd|th)\b/.test(m[3])) return null;
    // A bare year is a label, not a quantity. Counting to it reads as a
    // random number for most of the run.
    if (!m[1] && !m[3] && /^(19|20)\d{2}$/.test(m[2])) return null;
    const num = Number(m[2].replace(/,/g, ""));
    if (!Number.isFinite(num)) return null;
    const dec = (m[2].split(".")[1] ?? "").length;
    const grouped = m[2].includes(",");
    return { pre: m[1], num, suf: m[3], dec, grouped };
  };

  const run = (el: HTMLElement) => {
    const parsed = parse(el.dataset.count ?? "");
    if (!parsed) return;
    const { pre, num, suf, dec, grouped } = parsed;
    const fmt = (v: number) =>
      pre +
      (dec
        ? v.toFixed(dec)
        : grouped
          ? Math.round(v).toLocaleString("en-US")
          : String(Math.round(v))) +
      suf;
    const t0 = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / 1400);
      el.textContent = fmt(num * (1 - Math.pow(1 - t, 3)));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
